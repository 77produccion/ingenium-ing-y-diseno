---
import '../styles/global.css';
import ScrollReveals from '../components/ScrollReveals.astro';
import FloatingSocials from '../components/FloatingSocials.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "INGENIUM — Ingeniería y Diseño",
  description = "Ingeniería especializada para planear y ejecutar proyectos con claridad y rigor técnico.",
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3ec" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon_io/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon_io/site.webmanifest" />
    <title>{title}</title>

  </head>
  <body>
    <slot />
    <FloatingSocials />
    <ScrollReveals />
  </body>
</html>
