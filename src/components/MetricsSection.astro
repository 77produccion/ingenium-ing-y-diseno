---
// All five figures supplied by the client; area confirmed in the latest revision.
const metrics = [
  { value: '+600', count: 600, prefix: '+', suffix: '', label: 'Proyectos realizados', detail: 'Diseño, consultoría y construcción' },
  { value: '+8', count: 8, prefix: '+', suffix: '', label: 'Años de experiencia', detail: 'Trayectoria en el sector' },
  { value: '+150.000', count: 150000, prefix: '+', suffix: '', label: 'm² de estructura diseñada', detail: 'Ingeniería a cada escala' },
  { value: '100%', count: 100, prefix: '', suffix: '%', label: 'NSR-10', detail: 'En nuestros diseños' },
  { value: 'Diseño + construcción', count: null, prefix: '', suffix: '', label: 'Dirección técnica integral', detail: 'Un mismo equipo, de principio a fin' },
];
---
<section class="metrics-section" data-header-theme="dark" aria-labelledby="metrics-title">
  <div class="metrics-inner">
    <h2 id="metrics-title"><span>INGENIUM</span> en cifras</h2>
    <p class="metrics-intro">Una mirada integral, respaldada por método y experiencia técnica.</p>
    <div class="metrics-grid" data-reveal-children>
      {metrics.map(metric => <article class="metric"><strong aria-label={metric.value}><span aria-hidden="true" data-metric-counter={metric.count !== null ? '' : undefined} data-count={metric.count} data-prefix={metric.prefix} data-suffix={metric.suffix}>{metric.value}</span></strong><h3>{metric.label}</h3><p>{metric.detail}</p></article>)}
    </div>
  </div>
</section>
<style>
  .metrics-section { padding: 56px 4vw; color: var(--bg); background: linear-gradient(90deg,#0c1a34ed,#0c1a34d4),url('/assets/hero/subestacion-molinos/SaveClip.App_653765323_18060090317394760_542162242022376666_n.webp') center 46%/cover; }
  .metrics-inner { max-width: 1472px; margin: auto; }
  h2 { margin: 0; text-align: center; color: #fff; font: 700 clamp(34px,5vw,70px)/1.05 var(--font-heading); letter-spacing: -.045em; }
  h2 span { display: inline-block; padding: .04em .22em .12em; background: var(--brand-orange); transform: skew(-7deg); }
  .metrics-intro { max-width: 60ch; margin: 22px auto 32px; text-align: center; font: 400 var(--text-body)/1.6 var(--font-body); color: #d6d9df; }
  .metrics-grid { display: grid; grid-template-columns: 1fr .9fr 1.3fr .9fr 1.2fr; }
  .metric { min-width: 0; padding: 10px 16px; border-left: 1px solid #ffffff42; text-align: center; display: grid; grid-template-rows: minmax(76px, auto) minmax(48px, auto) auto; gap: 10px; align-content: start; }
  .metric:first-child { border: 0; }
  strong { display: block; align-self: center; font: 700 clamp(34px,3.5vw,58px)/1 var(--font-heading); letter-spacing: -.06em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .metric:last-child strong { white-space: normal; font: 400 clamp(23px,2.2vw,34px)/1.12 Arial,sans-serif; letter-spacing: -.025em; }
  h3 { align-self: center; margin: 0; color: #fff; font: 700 var(--text-label)/1.45 var(--font-body); }
  .metric p { margin: 0; color: #d6d9df; font: 400 var(--text-small)/1.6 var(--font-body); }
  @media(max-width:1023px) { .metrics-grid { grid-template-columns: repeat(3,1fr); gap: 28px 0; } .metric:nth-child(4) { border: 0; } }
  @media(max-width:767px) { .metrics-section { padding: 36px 20px; } .metrics-grid { grid-template-columns: 1fr 1fr; gap: 28px 16px; } .metric { padding: 0; border: 0; grid-template-rows: minmax(56px, auto) minmax(44px, auto) auto; gap: 8px; } strong { font-size: clamp(30px,7.5vw,44px); } .metric:last-child { grid-column: 1 / -1; padding-top: 24px; border-top: 1px solid #ffffff42; grid-template-rows: auto auto auto; } .metric:last-child strong { font-size: 30px; } }
</style>
<script>
  import { gsap } from 'gsap';
  const format = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 });
  const animations: gsap.core.Tween[] = [];
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const counter = entry.target as HTMLElement;
      observer.unobserve(counter);
      const value = { count: 0 };
      const render = () => { counter.textContent = `${counter.dataset.prefix ?? ''}${format.format(Math.round(value.count))}${counter.dataset.suffix ?? ''}`; };
      render();
      animations.push(gsap.to(value, { count: Number(counter.dataset.count), duration: 1.8, ease: 'power2.out', onUpdate: render }));
    });
  }, { threshold: .6 });
  document.querySelectorAll<HTMLElement>('[data-metric-counter]').forEach(counter => observer.observe(counter));
  const cleanup = () => { observer.disconnect(); animations.forEach(animation => animation.kill()); };
  document.addEventListener('astro:before-swap', cleanup, { once: true });
  import.meta.hot?.dispose(cleanup);
</script>
