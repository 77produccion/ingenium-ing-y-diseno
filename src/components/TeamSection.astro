---

<section class="team-section" id="equipo" data-header-theme="light" aria-labelledby="team-title">
  <div class="team-board">
    <div class="team-visual">
      <div class="team-photo-area" data-scroll-reveal>
        <div class="team-brand-mark" aria-hidden="true">
          <img src="/assets/logos/021026 INGENIUM - LOGO_2026-01.webp" alt="" />
        </div>
        <img class="team-feature-photo" data-team-photo src={selectedMember.photo} alt={`Retrato de ${selectedMember.name}`} />
      </div>

      <div class="team-member-picker" role="group" aria-label="Seleccionar integrante del equipo" data-reveal-children>
        {members.map((member) => (
          <button
            class:list={["team-member-button", { "is-selected": member.id === selectedMember.id }]}
            type="button"
            aria-label={`Ver perfil de ${member.name}`}
            aria-pressed={member.id === selectedMember.id ? "true" : "false"}
            data-team-member-id={member.id}
          >
            <img src={member.photo} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="team-content">
      <header class="team-heading" data-scroll-reveal>
        <p class="team-kicker">04 — EQUIPO</p>
        <h2 id="team-title">Conoce a nuestro equipo</h2>
        <p>Combinamos rigor técnico, especialización estructural y gestión estratégica para convertir proyectos ambiciosos en obras sólidas y seguras.</p>
      </header>

      <div class="team-profile-deck" data-scroll-reveal aria-live="polite">
        {members.map((member) => (
          <article
            class="team-profile"
            data-team-profile={member.id}
            data-photo={member.photo}
            aria-hidden={member.id === selectedMember.id ? "false" : "true"}
          >
            <div class="team-profile__identity" data-profile-reveal>
              <h3 class="team-profile__name">{member.name}</h3>
              <p class="team-profile__role">{member.role}</p>
            </div>
            <p class="team-profile__description" data-profile-reveal>{member.description}</p>
            <div
              class:list={["team-education", { "team-education--single": member.education.length === 1 }]}
              data-profile-reveal
            >
              {member.education.map((education) => (
                <article class:list={["team-education__item", { "team-education__item--solo": !education.university }]}>
                  <span class="team-education__degree">{education.degree}</span>
                  {education.university && (
                    <span class="team-education__logo">
                      {education.logo ? (
                        <img src={education.logo} alt={education.university} loading="lazy" decoding="async" />
                      ) : (
                        <span class="team-education__university">{education.university}</span>
                      )}
                    </span>
                  )}
                </article>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .team-section {
    --team-header-clearance: clamp(108px, 12svh, 128px);
    min-height: 100svh;
    padding: var(--team-header-clearance) 0 0;
    background: var(--bg-subtle);
  }

  .team-board {
    display: grid;
    width: 100%;
    height: calc(100svh - var(--team-header-clearance));
    min-height: 0;
    grid-template-columns: minmax(320px, 0.72fr) minmax(0, 1.28fr);
    overflow: hidden;
    background: var(--bg-subtle);
    border: 0;
  }

  .team-visual {
    position: relative;
    z-index: 0;
    display: grid;
    min-width: 0;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr) clamp(88px, 13svh, 116px);
    overflow: hidden;
    background: var(--bg);
  }

  .team-photo-area {
    position: relative;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .team-brand-mark {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: -140px;
    width: min(54vw, 600px);
    height: min(31vw, 350px);
    overflow: hidden;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
    pointer-events: none;
  }

  .team-brand-mark img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    clip-path: inset(20% 0 40% 0);
  }

  .team-feature-photo {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    will-change: transform, opacity;
  }

  .team-member-picker {
    position: relative;
    z-index: 2;
    display: grid;
    grid-auto-columns: minmax(56px, 1fr);
    grid-auto-flow: column;
    grid-template-columns: none;
    gap: 1px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
    background: var(--line-dark);
  }

  .team-member-button {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 44px;
    place-items: end center;
    overflow: hidden;
    padding: 0 4px;
    border: 0;
    border-top: 3px solid transparent;
    background: var(--brand-navy);
    cursor: pointer;
    scroll-snap-align: start;
    opacity: 0.72;
    transition: opacity 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .team-member-button:hover,
  .team-member-button.is-selected {
    opacity: 1;
  }

  .team-member-button.is-selected {
    border-top-color: var(--accent);
    background: #21366e;
  }

  .team-member-button:focus-visible {
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }

  .team-member-button img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 110px;
    object-fit: contain;
    object-position: center bottom;
  }

  .team-content {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    justify-content: center;
    gap: clamp(16px, 2svh, 24px);
    padding: clamp(20px, 2.5svh, 32px) clamp(24px, 3vw, 56px);
  }

  .team-heading {
    text-align: right;
  }

  .team-kicker {
    margin: 0 0 10px;
    color: var(--accent);
    font: 700 15px / 1.2 var(--font-heading);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .team-heading h2 {
    margin: 0 0 12px;
    color: #000;
    font: 700 clamp(32px, 3.4vw, 52px) / 1.04 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .team-heading > p:last-child {
    max-width: 760px;
    margin: 0 0 0 auto;
    color: var(--ink);
    font: 400 clamp(15px, 1.2vw, 18px) / 1.35 var(--font-body);
  }

  .team-profile-deck {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
    align-content: center;
  }

  .team-profile {
    display: grid;
    width: 100%;
    height: 100%;
    grid-area: 1 / 1;
    grid-template-rows: 0 auto minmax(56px, 1fr) auto;
    align-items: center;
    margin: 0 auto;
    text-align: center;
  }

  .team-profile__identity {
    display: flex;
    grid-row: 2;
    flex-direction: column;
    align-items: center;
  }

  .team-profile[aria-hidden="true"] {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .team-profile__name {
    max-width: 100%;
    margin: 0;
    padding: clamp(9px, 1vw, 14px) clamp(16px, 1.6vw, 24px);
    color: var(--bg);
    background: var(--brand-navy);
    font: 700 clamp(30px, 3.4vw, 52px) / 1.08 var(--font-heading);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .team-profile__role {
    width: min(76%, 520px);
    margin: 0;
    padding: 4px 14px 6px;
    color: #fff;
    background: var(--accent);
    font: 700 clamp(17px, 1.6vw, 24px) / 1.1 var(--font-heading);
    text-wrap: balance;
  }

  .team-profile__description {
    grid-row: 3;
    align-self: start;
    max-width: 640px;
    margin: clamp(18px, 2.4svh, 26px) auto 0;
    color: var(--ink);
    font: 400 clamp(15px, 1.1vw, 17px) / 1.4 var(--font-body);
    text-wrap: balance;
  }

  .team-education {
    display: grid;
    grid-row: 4;
    align-self: end;
    justify-self: center;
    width: min(100%, 760px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2.5vw, 32px);
    min-height: 68px;
    margin-top: clamp(18px, 2.4svh, 26px);
  }

  .team-education--single {
    grid-template-columns: minmax(0, min(420px, 100%));
    justify-content: center;
  }

  .team-education:empty {
    display: none;
  }

  .team-education__item {
    display: grid;
    min-width: 0;
    min-height: 64px;
    grid-template-columns: minmax(0, 1fr) minmax(76px, 0.8fr);
    background: #fff;
  }

  .team-education__item--solo {
    width: min(100%, 420px);
    grid-column: 1 / -1;
    grid-template-columns: 1fr;
    justify-self: center;
  }

  .team-education__degree {
    display: flex;
    align-items: center;
    padding: 12px clamp(10px, 1vw, 16px);
    color: #fff;
    background: var(--accent);
    font: 700 clamp(13px, 1.3vw, 17px) / 1.15 var(--font-heading);
    text-align: left;
    text-transform: uppercase;
  }

  .team-education__item--solo .team-education__degree {
    justify-content: center;
    text-align: center;
  }

  .team-education__logo {
    display: grid;
    min-width: 0;
    place-items: center;
    padding: 8px;
    background: #fff;
  }

  .team-education__logo img {
    display: block;
    width: 100%;
    max-width: 118px;
    max-height: 58px;
    object-fit: contain;
  }

  .team-education__university {
    color: var(--brand-navy);
    font: 400 clamp(10px, 0.95vw, 13px) / 1.2 var(--font-body);
    text-align: center;
  }

  @media (max-width: 900px) {
    .team-board {
      grid-template-columns: minmax(240px, 0.78fr) minmax(0, 1.22fr);
    }

    .team-visual {
      grid-template-rows: minmax(0, 1fr) auto;
    }

    .team-member-picker {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-auto-rows: clamp(68px, 9svh, 82px);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow-x: hidden;
    }

    .team-content {
      padding: 20px 24px;
    }

    .team-heading h2 {
      font-size: clamp(32px, 4.5vw, 46px);
    }

    .team-profile__name {
      font-size: clamp(30px, 4vw, 44px);
    }

    .team-profile__role {
      width: 84%;
      font-size: clamp(17px, 2.2vw, 22px);
    }

    .team-education {
      gap: 12px;
    }
  }

  @media (max-height: 760px) and (min-width: 701px) {
    .team-content {
      padding: 16px clamp(18px, 2.4vw, 32px);
      gap: 12px;
    }

    .team-heading h2 {
      font-size: clamp(30px, 3vw, 44px);
    }

    .team-heading > p:last-child {
      font-size: 15px;
    }

    .team-profile {
      margin-top: 0;
    }

    .team-profile__name {
      padding: 8px 14px;
      font-size: clamp(28px, 3vw, 42px);
    }

    .team-profile__role {
      font-size: clamp(16px, 1.5vw, 21px);
    }

    .team-profile__description {
      margin-top: 14px;
      font-size: 15px;
    }

    .team-education {
      min-height: 58px;
      margin-top: 16px;
    }

    .team-education__item {
      min-height: 58px;
    }
  }

  @media (max-width: 700px) {
    .team-section {
      --team-header-clearance: 92px;
      min-height: 0;
      padding: var(--team-header-clearance) 0 20px;
    }

    .team-board {
      display: grid;
      height: auto;
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      overflow: visible;
    }

    .team-content {
      display: contents;
    }

    .team-heading {
      grid-row: 1;
      padding: 24px 7vw 22px;
      text-align: left;
    }

    .team-heading .team-kicker {
      margin-bottom: 8px;
      font-size: 12px;
    }

    .team-heading h2 {
      margin-bottom: 8px;
      font-size: clamp(30px, 7.4vw, 38px);
      line-height: 1.06;
    }

    .team-heading > p:last-child {
      max-width: 38ch;
      margin: 0;
      font-size: 14px;
      line-height: 1.45;
    }

    .team-visual {
      grid-row: 2;
      min-height: 0;
      height: auto;
      grid-template-rows: clamp(300px, 95vw, 400px) 62px;
    }

    .team-member-picker {
      display: flex;
      height: 62px;
      flex-flow: row nowrap;
      gap: 1px;
      overflow-x: auto;
      overflow-y: hidden;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    .team-member-picker::-webkit-scrollbar {
      display: none;
    }

    .team-member-button {
      flex: 0 0 clamp(48px, 14vw, 60px);
      width: clamp(48px, 14vw, 60px);
      height: 62px;
      min-height: 0;
      padding-inline: 2px;
      scroll-snap-align: start;
    }

    .team-member-button img {
      max-height: 55px;
    }

    .team-brand-mark {
      left: -82px;
      width: min(72vw, 330px);
      height: min(50vw, 220px);
    }

    .team-profile-deck {
      grid-row: 3;
      width: 100%;
      min-height: 0;
      padding: 24px 7vw 32px;
    }

    .team-profile {
      height: auto;
      grid-template-rows: auto;
      margin-top: 0;
    }

    .team-profile__identity,
    .team-profile__description,
    .team-education {
      grid-row: auto;
    }

    .team-profile__description {
      align-self: auto;
    }

    .team-profile__name {
      font-size: clamp(26px, 7vw, 36px);
    }

    .team-profile__role {
      width: min(92%, 380px);
      font-size: 16px;
    }

    .team-profile__description {
      font-size: 14px;
      line-height: 1.55;
    }

    .team-education {
      gap: 10px;
    }

    .team-education__item {
      min-height: 64px;
      grid-template-columns: minmax(0, 1fr) minmax(50px, 0.8fr);
    }

    .team-education__item--solo {
      grid-template-columns: 1fr;
    }

    .team-education__degree {
      padding: 8px;
      font-size: 10px;
    }

    .team-education__logo {
      padding: 5px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const sections = document.querySelectorAll<HTMLElement>(".team-section");

  sections.forEach((section) => {
    const photo = section.querySelector<HTMLImageElement>("[data-team-photo]");
    const profiles = Array.from(section.querySelectorAll<HTMLElement>("[data-team-profile]"));
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-team-member-id]"));

    if (!photo || profiles.length === 0 || buttons.length === 0) return;

    const context = gsap.context(() => {}, section);
    let isSwitching = false;

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (isSwitching || button.getAttribute("aria-pressed") === "true") return;

        const nextProfile = profiles.find((profile) => profile.dataset.teamProfile === button.dataset.teamMemberId);
        const currentProfile = profiles.find((profile) => profile.getAttribute("aria-hidden") === "false");
        if (!nextProfile || !currentProfile) return;

        isSwitching = true;
        buttons.forEach((candidate) => {
          const selected = candidate === button;
          candidate.setAttribute("aria-pressed", String(selected));
          candidate.classList.toggle("is-selected", selected);
        });

        context.add(() => {
          const timeline = gsap.timeline({
            onComplete: () => { isSwitching = false; },
          });

          timeline.to([photo, currentProfile], {
            autoAlpha: 0,
            y: -10,
            duration: 0.2,
            ease: "power1.in",
          });
          timeline.call(() => {
            const profileName = nextProfile.querySelector<HTMLElement>(".team-profile__name")?.textContent ?? "integrante del equipo";
            photo.src = nextProfile.dataset.photo ?? "";
            photo.alt = `Retrato de ${profileName}`;
            currentProfile.setAttribute("aria-hidden", "true");
            nextProfile.setAttribute("aria-hidden", "false");
            gsap.set(nextProfile, { autoAlpha: 0, y: 16 });
          });
          timeline.to(photo, {
            autoAlpha: 1,
            y: 0,
            duration: 0.52,
            ease: "power2.out",
          });

          const textTargets = Array.from(nextProfile.querySelectorAll<HTMLElement>("[data-profile-reveal]"))
            .filter((element) => !element.classList.contains("team-education") || element.childElementCount > 0);

          timeline.to(nextProfile, {
            autoAlpha: 1,
            y: 0,
            duration: 0.48,
            ease: "power2.out",
          }, "<");
          timeline.fromTo(
            textTargets,
            { autoAlpha: 0, y: 18 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.48,
              stagger: { each: 0.075, from: "end" },
              ease: "power2.out",
              clearProps: "transform,opacity,visibility",
            },
            "<+0.02",
          );
        });
      });
    });

    document.addEventListener("astro:before-swap", () => context.revert(), { once: true });
    import.meta.hot?.dispose(() => context.revert());
  });
