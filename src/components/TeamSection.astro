---
interface Education {
  degree: string;
  university: string;
  logo: string;
}

interface TeamMember {
  id: string;
  name: string;
  role: string;
  description: string;
  photo: string;
  education: Education[];
}

const members: TeamMember[] = [
  {
    id: "julian",
    name: "Julián",
    role: "Integrante del equipo",
    description: "Forma parte del equipo multidisciplinario de INGENIUM.",
    photo: "/assets/team/Julian.png",
    education: [],
  },
  {
    id: "leonardo",
    name: "Leonardo González",
    role: "Gerente Administrativo",
    description: "Articula la precisión técnica con la eficiencia operativa y financiera, asegurando una gestión impecable de recursos y procesos corporativos.",
    photo: "/assets/team/Leonardo.png",
    education: [
      {
        degree: "Ingeniero Civil",
        university: "Universidad del Quindío",
        logo: "/assets/team/logos-universidades/uniquindio-logo.webp",
      },
      {
        degree: "Especialista en Estructuras",
        university: "Universidad Nacional de Colombia",
        logo: "/assets/team/logos-universidades/unal-logo.webp",
      },
    ],
  },
  {
    id: "sebastian",
    name: "Sebastian",
    role: "Integrante del equipo",
    description: "Forma parte del equipo multidisciplinario de INGENIUM.",
    photo: "/assets/team/sebastian.png",
    education: [],
  },
  {
    id: "julio",
    name: "Julio",
    role: "Integrante del equipo",
    description: "Forma parte del equipo multidisciplinario de INGENIUM.",
    photo: "/assets/team/julio.png",
    education: [],
  },
];

const selectedMember = members.find((member) => member.id === "leonardo") ?? members[0];
---

<section class="team-section" id="equipo" data-header-theme="light" aria-labelledby="team-title">
  <div class="team-board">
    <div class="team-visual">
      <div class="team-photo-area" data-scroll-reveal>
        <div class="team-brand-mark" aria-hidden="true">
          <img src="/assets/logos/021026 INGENIUM - LOGO_2026-01.png" alt="" />
        </div>
        <img class="team-feature-photo" data-team-photo src={selectedMember.photo} alt={`Retrato de ${selectedMember.name}`} />
      </div>

      <div class="team-member-picker" role="group" aria-label="Seleccionar integrante del equipo" data-reveal-children>
        {members.map((member) => (
          <button
            class:list={["team-member-button", { "is-selected": member.id === selectedMember.id }]}
            type="button"
            aria-label={`Ver perfil de ${member.name}`}
            aria-pressed={member.id === selectedMember.id ? "true" : "false"}
            data-team-member={JSON.stringify(member)}
          >
            <img src={member.photo} alt="" aria-hidden="true" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>

    <div class="team-content">
      <header class="team-heading" data-scroll-reveal>
        <p class="team-kicker">04 — EQUIPO</p>
        <h2 id="team-title">Conoce a nuestro equipo</h2>
        <p>Combinamos rigor técnico, especialización estructural y gestión estratégica para convertir proyectos ambiciosos en obras sólidas y seguras.</p>
      </header>

      <div class="team-profile" data-team-profile data-scroll-reveal aria-live="polite">
        <h3 class="team-profile__name" data-member-name>{selectedMember.name}</h3>
        <p class="team-profile__role" data-member-role>{selectedMember.role}</p>
        <p class="team-profile__description" data-member-description>{selectedMember.description}</p>
        <div class="team-education" data-member-education>
          {selectedMember.education.map((education) => (
            <article class="team-education__item">
              <span class="team-education__degree">{education.degree}</span>
              <span class="team-education__logo">
                <img src={education.logo} alt={education.university} loading="lazy" decoding="async" />
              </span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .team-section {
    min-height: 100svh;
    padding: clamp(8px, 1vw, 16px);
    background: #15171c;
  }

  .team-board {
    display: grid;
    width: 100%;
    min-height: calc(100svh - 2 * clamp(8px, 1vw, 16px));
    grid-template-columns: minmax(320px, 0.72fr) minmax(0, 1.28fr);
    overflow: hidden;
    background: var(--bg-subtle);
    border: 1px solid rgba(255, 255, 255, 0.75);
  }

  .team-visual {
    position: relative;
    z-index: 0;
    display: grid;
    min-width: 0;
    min-height: calc(100svh - 2 * clamp(8px, 1vw, 16px));
    grid-template-rows: minmax(0, 1fr) clamp(88px, 13svh, 116px);
    overflow: hidden;
    background: var(--bg);
  }

  .team-photo-area {
    position: relative;
    min-height: 0;
    overflow: hidden;
    isolation: isolate;
  }

  .team-brand-mark {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: -140px;
    width: min(54vw, 600px);
    height: min(31vw, 350px);
    overflow: hidden;
    transform: translateY(-50%) rotate(90deg);
    transform-origin: center;
    pointer-events: none;
  }

  .team-brand-mark img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    clip-path: inset(20% 0 40% 0);
  }

  .team-feature-photo {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    will-change: transform, opacity;
  }

  .team-member-picker {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-dark);
  }

  .team-member-button {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 44px;
    place-items: end center;
    overflow: hidden;
    padding: 0 4px;
    border: 0;
    border-top: 3px solid transparent;
    background: var(--brand-navy);
    cursor: pointer;
    opacity: 0.72;
    transition: opacity 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }

  .team-member-button:hover,
  .team-member-button.is-selected {
    opacity: 1;
  }

  .team-member-button.is-selected {
    border-top-color: var(--accent);
    background: #21366e;
  }

  .team-member-button:focus-visible {
    z-index: 1;
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }

  .team-member-button img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 110px;
    object-fit: contain;
    object-position: center bottom;
  }

  .team-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(30px, 4vw, 66px) clamp(28px, 4vw, 64px);
  }

  .team-heading {
    text-align: right;
  }

  .team-kicker {
    margin: 0 0 10px;
    color: var(--accent);
    font: 700 15px / 1.2 var(--font-heading);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .team-heading h2 {
    margin: 0 0 12px;
    color: #000;
    font: 700 clamp(34px, 4vw, 62px) / 1.04 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .team-heading > p:last-child {
    max-width: 760px;
    margin: 0 0 0 auto;
    color: var(--ink);
    font: 400 clamp(16px, 1.45vw, 20px) / 1.35 var(--font-body);
  }

  .team-profile {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: clamp(24px, 4svh, 46px) auto 0;
    text-align: center;
  }

  .team-profile__name {
    max-width: 100%;
    margin: 0;
    padding: clamp(9px, 1vw, 14px) clamp(16px, 1.6vw, 24px);
    color: var(--bg);
    background: var(--brand-navy);
    font: 700 clamp(32px, 4.15vw, 62px) / 1.08 var(--font-heading);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .team-profile__role {
    width: min(76%, 520px);
    margin: 0;
    padding: 4px 14px 6px;
    color: #fff;
    background: var(--accent);
    font: 700 clamp(18px, 2vw, 28px) / 1.1 var(--font-heading);
    text-wrap: balance;
  }

  .team-profile__description {
    max-width: 640px;
    margin: clamp(22px, 3.4svh, 34px) auto 0;
    color: var(--ink);
    font: 400 clamp(16px, 1.4vw, 19px) / 1.45 var(--font-body);
    text-wrap: balance;
  }

  .team-education {
    display: grid;
    width: min(100%, 760px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 2.5vw, 32px);
    min-height: 82px;
    margin-top: clamp(26px, 4svh, 40px);
  }

  .team-education:empty {
    display: none;
  }

  .team-education__item {
    display: grid;
    min-width: 0;
    min-height: 76px;
    grid-template-columns: minmax(0, 1fr) minmax(76px, 0.8fr);
    background: #fff;
  }

  .team-education__degree {
    display: flex;
    align-items: center;
    padding: 12px clamp(10px, 1vw, 16px);
    color: #fff;
    background: var(--accent);
    font: 700 clamp(13px, 1.3vw, 17px) / 1.15 var(--font-heading);
    text-align: left;
    text-transform: uppercase;
  }

  .team-education__logo {
    display: grid;
    min-width: 0;
    place-items: center;
    padding: 8px;
    background: #fff;
  }

  .team-education__logo img {
    display: block;
    width: 100%;
    max-width: 118px;
    max-height: 58px;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .team-board {
      grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
    }

    .team-content {
      padding: 30px 28px;
    }

    .team-heading h2 {
      font-size: clamp(32px, 4.5vw, 46px);
    }

    .team-profile__name {
      font-size: clamp(30px, 4vw, 44px);
    }

    .team-profile__role {
      width: 84%;
      font-size: clamp(17px, 2.2vw, 22px);
    }

    .team-education {
      gap: 12px;
    }
  }

  @media (max-width: 700px) {
    .team-section {
      min-height: 0;
      padding: 8px;
    }

    .team-board {
      min-height: 0;
      grid-template-columns: 1fr;
    }

    .team-visual {
      min-height: 0;
      height: clamp(560px, 82svh, 720px);
      grid-template-rows: minmax(0, 1fr) 88px;
    }

    .team-brand-mark {
      left: -112px;
      width: min(92vw, 450px);
      height: min(62vw, 280px);
    }

    .team-content {
      min-height: 660px;
      padding: 38px 7vw 48px;
    }

    .team-heading {
      text-align: left;
    }

    .team-heading h2 {
      font-size: clamp(34px, 8vw, 48px);
    }

    .team-profile {
      margin-top: 32px;
    }

    .team-profile__name {
      font-size: clamp(29px, 7.5vw, 42px);
    }

    .team-profile__role {
      width: 88%;
      font-size: 19px;
    }

    .team-profile__description {
      font-size: 16px;
    }

    .team-education {
      gap: 10px;
    }

    .team-education__item {
      min-height: 78px;
      grid-template-columns: minmax(0, 1fr) minmax(54px, 0.8fr);
    }

    .team-education__degree {
      padding: 8px;
      font-size: 11px;
    }

    .team-education__logo {
      padding: 5px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  type TeamEducation = { degree: string; university: string; logo: string };
  type TeamMemberProfile = {
    id: string;
    name: string;
    role: string;
    description: string;
    photo: string;
    education: TeamEducation[];
  };

  const sections = document.querySelectorAll<HTMLElement>(".team-section");

  sections.forEach((section) => {
    const photo = section.querySelector<HTMLImageElement>("[data-team-photo]");
    const name = section.querySelector<HTMLElement>("[data-member-name]");
    const role = section.querySelector<HTMLElement>("[data-member-role]");
    const description = section.querySelector<HTMLElement>("[data-member-description]");
    const education = section.querySelector<HTMLElement>("[data-member-education]");
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-team-member]"));

    if (!photo || !name || !role || !description || !education || buttons.length === 0) return;

    const context = gsap.context(() => {}, section);
    let isSwitching = false;

    function renderEducation(entries: TeamEducation[]) {
      education.replaceChildren();

      entries.forEach((entry) => {
        const item = document.createElement("article");
        item.className = "team-education__item";

        const degree = document.createElement("span");
        degree.className = "team-education__degree";
        degree.textContent = entry.degree;

        const logoWrap = document.createElement("span");
        logoWrap.className = "team-education__logo";
        const logo = document.createElement("img");
        logo.src = entry.logo;
        logo.alt = entry.university;
        logo.loading = "lazy";
        logo.decoding = "async";
        logoWrap.append(logo);

        item.append(degree, logoWrap);
        education.append(item);
      });
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        if (isSwitching || button.getAttribute("aria-pressed") === "true") return;

        let next: TeamMemberProfile;
        try {
          next = JSON.parse(button.dataset.teamMember ?? "") as TeamMemberProfile;
        } catch {
          return;
        }

        isSwitching = true;
        buttons.forEach((candidate) => {
          const selected = candidate === button;
          candidate.setAttribute("aria-pressed", String(selected));
          candidate.classList.toggle("is-selected", selected);
        });

        context.add(() => {
          const photoAndDetails = [photo, name, role, description, education];
          const timeline = gsap.timeline({
            onComplete: () => { isSwitching = false; },
          });
          const textTargets = [education, description, role, name];

          timeline.to([...photoAndDetails], {
            autoAlpha: 0,
            y: -10,
            duration: 0.2,
            ease: "power1.in",
          });
          timeline.call(() => {
            photo.src = next.photo;
            photo.alt = `Retrato de ${next.name}`;
            name.textContent = next.name;
            role.textContent = next.role;
            description.textContent = next.description;
            renderEducation(next.education);
            gsap.set(photoAndDetails, { autoAlpha: 0, y: 16 });
          });
          timeline.to(photo, {
            autoAlpha: 1,
            y: 0,
            duration: 0.52,
            ease: "power2.out",
          });

          timeline.fromTo(
            textTargets,
            { autoAlpha: 0, y: 18 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.48,
              stagger: 0.075,
              ease: "power2.out",
              clearProps: "transform,opacity,visibility",
            },
            "<+0.02",
          );
        });
      });
    });

    document.addEventListener("astro:before-swap", () => context.revert(), { once: true });
    import.meta.hot?.dispose(() => context.revert());
  });
</script>
