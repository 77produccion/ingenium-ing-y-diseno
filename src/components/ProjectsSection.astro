for (const project of [...residentialProjects, ...technicalProjects]) {
  project.gallery = getProjectGallery(project.folder);
}

const projectGroups = [
  {
    id: 'residencial',
    title: 'Vivienda campestre y residencial',
    description: 'Construcción integral',
    projects: residentialProjects,
  },
  {
    id: 'tecnico',
    title: 'Comercial, institucional y supervisión técnica',
    description: 'Obras y acompañamiento especializado',
    projects: technicalProjects,
  },
];

const encodeProject = (project: (typeof residentialProjects)[number] | (typeof technicalProjects)[number]) =>
  JSON.stringify(project).replaceAll('&', '\u0026');
---

<section class="projects-section" id="proyectos" data-header-theme="light" aria-labelledby="projects-title">
  <div class="projects-section__inner">
    <header class="projects-section__intro" data-scroll-reveal>
      <div data-scroll-reveal data-reveal-style="sweep">
        <p class="projects-section__eyebrow">INGENIUM / PORTAFOLIO</p>
        <h2 id="projects-title">Proyectos</h2>
      </div>
      <p class="projects-section__summary">Obras desarrolladas con criterio técnico, desde la idea hasta su ejecución.</p>
    </header>

    <div class="projects-groups">
      {projectGroups.map((group) => (
        <section class="project-group" aria-labelledby={`project-group-${group.id}`}>
          <header class="project-group__heading" data-scroll-reveal data-reveal-style="sweep">
            <div class="project-group__label">
              <div>
                <h3 id={`project-group-${group.id}`}>{group.title}</h3>
                <p>{group.description}</p>
              </div>
            </div>
            <div class="project-group__controls" aria-label={`Desplazar cinta: ${group.title}`}>
              <button type="button" data-rail-direction="-1" aria-label="Ver proyectos anteriores">←</button>
              <button type="button" data-rail-direction="1" aria-label="Ver más proyectos">→</button>
            </div>
          </header>

          <div class="project-rail" data-project-rail tabindex="0" aria-label={`Proyectos: ${group.title}`}>
            {group.projects.map((project, projectIndex) => (
              <button
                class="project-card"
                type="button"
                data-project-card
                data-scroll-reveal
                data-reveal-style="pop"
                data-project={encodeProject(project)}
                aria-label={`Ver detalles de ${project.title}`}
              >
                <span class="project-card__image-wrap">
                  <img src={project.cover} alt="" loading="lazy" decoding="async" />
                  <span class="project-card__shade"></span>
                  <span class="project-card__index">{String(projectIndex + 1).padStart(2, '0')}</span>
                  {project.status && <span class:list={['project-card__status', { 'is-active': project.status === 'En ejecución' }]}>{project.status}</span>}
                  <span class="project-card__copy">
                    <strong>{project.title}</strong>
                    <span class="project-card__more">Ver proyecto <span aria-hidden="true">↗</span></span>
                  </span>
                </span>
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>

  <div class="project-modal" data-project-modal hidden>
    <div class="project-modal__backdrop" data-project-modal-backdrop></div>
    <div class="project-modal__panel" role="dialog" aria-modal="true" aria-labelledby="project-modal-title" aria-describedby="project-modal-subtitle">
      <section class="project-modal__details">
        <div class="project-modal__topline">
          <span>INGENIUM / PROYECTO</span>
          <button class="project-modal__close" type="button" data-project-close aria-label="Cerrar detalle del proyecto">×</button>
        </div>
        <p class="project-modal__category" data-project-category></p>
        <h2 id="project-modal-title" data-project-title></h2>
        <p class="project-modal__subtitle" id="project-modal-subtitle" data-project-subtitle></p>

        <dl class="project-modal__facts">
          <div>
            <dt>Sistema</dt>
            <dd data-project-system></dd>
          </div>
          <div>
            <dt>Alcance</dt>
            <dd data-project-scope></dd>
          </div>
          <div data-project-status-row>
            <dt>Estado</dt>
            <dd data-project-status></dd>
          </div>
        </dl>

        <div class="project-modal__footer">
          <span data-project-counter>01 / 11</span>
          <a href="/#contacto">Hablemos de tu proyecto <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="project-modal__media" aria-label="Galería del proyecto">
        <div class="project-modal__main-image">
          <img data-project-main-image alt="" />
          <span class="project-modal__image-count" data-image-count>01 / 01</span>
        </div>
        <div class="project-gallery-shell">
          <div class="project-gallery" data-project-gallery aria-label="Seleccionar imagen de galería"></div>
          <button class="project-gallery__control project-gallery__control--previous" type="button" data-gallery-page="-1" aria-label="Ver las 10 imágenes anteriores" disabled>‹</button>
          <button class="project-gallery__control project-gallery__control--next" type="button" data-gallery-page="1" aria-label="Ver las siguientes 10 imágenes" disabled>›</button>
        </div>
      </section>
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: clamp(56px, 6vw, 84px) clamp(24px, 6vw, 96px);
    color: var(--brand-navy);
    background: var(--bg);
  }

  .projects-section__inner {
    width: min(100%, 1600px);
    margin-inline: auto;
  }

  .projects-section__intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(44px, 5vw, 68px);
  }

  .projects-section__eyebrow {
    margin: 0 0 12px;
    color: var(--brand-orange);
    font: 400 11px / 1.3 var(--font-mono);
    letter-spacing: 0.14em;
  }

  .projects-section__intro h2 {
    margin: 0;
    color: var(--brand-navy);
    font: 700 clamp(42px, 6vw, 76px) / 0.98 var(--font-heading);
    letter-spacing: -0.06em;
  }

  .projects-section__summary {
    max-width: 34ch;
    margin: 0 0 5px;
    color: var(--ink-secondary);
    font-size: clamp(14px, 1.35vw, 17px);
    line-height: 1.55;
  }

  .projects-groups {
    display: grid;
    gap: clamp(44px, 6vw, 78px);
  }

  .project-group {
    min-width: 0;
  }

  .project-group__heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--brand-navy);
  }

  .project-group__label {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .project-group__heading h3 {
    margin: 0;
    color: var(--brand-navy);
    font: 700 clamp(19px, 2vw, 26px) / 1.12 var(--font-heading);
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .project-group__heading p {
    margin: 5px 0 0;
    color: var(--ink-secondary);
    font-size: 13px;
  }

  .project-group__controls {
    display: flex;
    flex: 0 0 auto;
    gap: 8px;
  }

  .project-group__controls button {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(26, 43, 81, 0.28);
    border-radius: 50%;
    background: transparent;
    color: var(--brand-navy);
    cursor: pointer;
    font-size: 20px;
    transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .project-group__controls button:hover {
    border-color: var(--brand-navy);
    background: var(--brand-navy);
    color: var(--bg);
  }

  .project-rail {
    display: flex;
    gap: clamp(12px, 1.5vw, 20px);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 0 0 8px;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .project-rail::-webkit-scrollbar {
    display: none;
  }

  .project-card {
    position: relative;
    display: block;
    flex: 0 0 clamp(205px, 22vw, 292px);
    height: clamp(190px, 19vw, 252px);
    overflow: hidden;
    padding: 0;
    border: 0;
    background: var(--brand-navy);
    color: white;
    cursor: pointer;
    isolation: isolate;
    scroll-snap-align: start;
    text-align: left;
  }

  .project-card__image-wrap,
  .project-card__image-wrap > img,
  .project-card__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project-card__image-wrap > img {
    z-index: -2;
    display: block;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.2, 0.75, 0.25, 1), filter 400ms ease;
  }

  .project-card__shade {
    z-index: -1;
    background: linear-gradient(180deg, rgba(15, 31, 59, 0.04) 10%, rgba(15, 31, 59, 0.04) 32%, rgba(15, 31, 59, 0.88) 100%);
    transition: opacity 320ms ease;
  }

  .project-card:hover .project-card__image-wrap > img,
  .project-card:focus-visible .project-card__image-wrap > img {
    filter: saturate(1.12);
    transform: scale(1.055);
  }

  .project-card__index {
    position: absolute;
    top: 14px;
    left: 15px;
    color: rgba(255, 255, 255, 0.9);
    font: 400 11px / 1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .project-card__status {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 6px 9px;
    background: rgba(246, 243, 236, 0.93);
    color: var(--brand-navy);
    font: 400 10px / 1 var(--font-body);
  }

  .project-card__status.is-active {
    background: var(--brand-orange);
    color: white;
  }

  .project-card__copy {
    position: absolute;
    right: 16px;
    bottom: 15px;
    left: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .project-card__copy strong {
    color: white;
    font: 700 clamp(17px, 1.45vw, 21px) / 1.08 var(--font-heading);
    letter-spacing: -0.025em;
  }

  .project-card__more {
    display: flex;
    max-height: 0;
    align-items: center;
    gap: 10px;
    overflow: hidden;
    margin-top: 0;
    color: var(--bg);
    font-size: 12px;
    opacity: 0;
    transition: max-height 260ms ease, margin 260ms ease, opacity 260ms ease;
  }

  .project-card__more span {
    color: var(--brand-orange);
    font-size: 18px;
  }

  .project-card:hover .project-card__more,
  .project-card:focus-visible .project-card__more {
    max-height: 24px;
    margin-top: 10px;
    opacity: 1;
  }

  .project-card:focus-visible,
  .project-group__controls button:focus-visible,
  .project-modal button:focus-visible,
  .project-modal a:focus-visible {
    outline: 2px solid var(--brand-orange);
    outline-offset: 3px;
  }

  .project-modal[hidden] {
    display: none;
  }

  .project-modal {
    position: fixed;
    z-index: 300;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 28px;
  }

  .project-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 17, 34, 0.78);
    backdrop-filter: blur(5px);
  }

  .project-modal__panel {
    position: relative;
    display: grid;
    width: min(100%, 1180px);
    height: min(700px, calc(100svh - 56px));
    min-height: 500px;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.22fr);
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3);
  }

  .project-modal__details {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow-y: auto;
    padding: clamp(26px, 3vw, 44px);
    background: var(--bg);
  }

  .project-modal__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    color: var(--ink-secondary);
    font: 400 10px / 1.4 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .project-modal__close {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(26, 43, 81, 0.24);
    border-radius: 50%;
    background: transparent;
    color: var(--brand-navy);
    cursor: pointer;
    font: 400 28px / 1 var(--font-body);
    transition: color 200ms ease, background-color 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .project-modal__close:hover {
    border-color: #c93333;
    background: #c93333;
    color: #fff;
  }

  .project-modal__close:active {
    transform: scale(0.94);
  }

  .project-modal__category {
    margin: clamp(32px, 5vh, 58px) 0 12px;
    color: var(--brand-orange);
    font: 400 11px / 1.4 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .project-modal__details h2 {
    margin: 0;
    color: var(--brand-navy);
    font: 700 clamp(30px, 3vw, 46px) / 1.02 var(--font-heading);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .project-modal__subtitle {
    margin: 12px 0 0;
    color: var(--ink-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  .project-modal__facts {
    display: grid;
    gap: 0;
    margin: clamp(28px, 4vh, 48px) 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .project-modal__facts > div {
    display: grid;
    grid-template-columns: minmax(76px, 0.55fr) minmax(0, 1fr);
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .project-modal__facts > [hidden] {
    display: none;
  }

  .project-modal__facts dt {
    color: var(--ink-secondary);
    font-size: 12px;
  }

  .project-modal__facts dd {
    margin: 0;
    color: var(--brand-navy);
    font: 700 13px / 1.4 var(--font-heading);
  }

  .project-modal__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: auto;
    padding-top: 28px;
  }

  .project-modal__footer > span {
    color: var(--ink-secondary);
    font: 400 10px / 1.4 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .project-modal__footer a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-navy);
    font: 700 12px / 1.35 var(--font-heading);
    text-align: right;
  }

  .project-modal__footer a span {
    color: var(--brand-orange);
    font-size: 18px;
  }

  .project-modal__media {
    display: grid;
    min-width: 0;
    min-height: 0;
    grid-template-rows: minmax(0, 1fr) 72px;
    gap: 0;
    padding: 16px;
    background: #172847;
  }

  .project-modal__main-image {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #20385f;
  }

  .project-modal__main-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transform: scale(1);
    transition: opacity 260ms ease, transform 420ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .project-modal__main-image img.is-transitioning {
    opacity: 0;
    transform: scale(1.012);
  }

  .project-modal__image-count {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 7px 10px;
    background: rgba(15, 31, 59, 0.78);
    color: white;
    font: 400 10px / 1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .project-gallery-shell {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: 26px minmax(0, 1fr) 26px;
    overflow: hidden;
  }

  .project-gallery {
    display: flex;
    grid-column: 2;
    min-width: 0;
    height: 100%;
    gap: 0;
    overflow: hidden;
    padding: 0;
    scrollbar-width: none;
  }

  .project-gallery::-webkit-scrollbar {
    display: none;
  }

  .project-gallery :global(.project-gallery__thumb) {
    position: relative;
    flex: 0 0 10%;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border: 0;
    background: #20385f;
    cursor: pointer;
  }

  .project-gallery :global(.project-gallery__thumb img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.64;
    transition: opacity 200ms ease, transform 280ms ease;
  }

  .project-gallery :global(.project-gallery__thumb[aria-pressed='true']) {
    box-shadow: inset 0 0 0 2px var(--brand-orange);
  }

  .project-gallery :global(.project-gallery__thumb[aria-pressed='true'] img),
  .project-gallery :global(.project-gallery__thumb:hover img) {
    opacity: 1;
    transform: scale(1.04);
  }

  .project-gallery__control {
    z-index: 2;
    display: grid;
    width: 26px;
    height: 100%;
    place-items: center;
    padding: 0;
    border: 0;
    background: #172847;
    color: rgba(246, 243, 236, 0.82);
    cursor: pointer;
    font: 400 24px / 1 var(--font-body);
    transition: color 180ms ease, background-color 180ms ease;
  }

  .project-gallery__control--previous {
    grid-column: 1;
  }

  .project-gallery__control--next {
    grid-column: 3;
  }

  .project-gallery__control:hover:not(:disabled) {
    background: var(--brand-orange);
    color: #fff;
  }

  .project-gallery__control:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  .project-gallery__control[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .projects-section {
      padding-inline: 20px;
    }

    .projects-section__intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }

    .projects-section__summary {
      max-width: 42ch;
    }

    .project-card {
      flex-basis: min(72vw, 280px);
      height: 220px;
    }

    .project-modal {
      padding: 12px;
    }

    .project-modal__panel {
      width: 100%;
      height: min(840px, calc(100svh - 24px));
      min-height: 0;
      grid-template-columns: 1fr;
      grid-template-rows: minmax(250px, 43svh) minmax(280px, 1fr);
      overflow-y: auto;
    }

    .project-modal__media {
      grid-row: 1;
      grid-template-rows: minmax(0, 1fr) 56px;
      gap: 0;
      padding: 12px;
    }

    .project-gallery__control {
      width: 22px;
    }

    .project-gallery-shell {
      grid-template-columns: 22px minmax(0, 1fr) 22px;
    }

    .project-modal__details {
      grid-row: 2;
      padding: 24px;
    }

    .project-modal__category {
      margin-top: 26px;
    }

    .project-modal__facts {
      margin-top: 24px;
    }

    .project-modal__footer {
      margin-top: 28px;
    }
  }

  @media (max-width: 460px) {
    .project-group__heading {
      align-items: center;
    }

    .project-group__heading h3 {
      font-size: 17px;
    }

    .project-group__controls button {
      width: 34px;
      height: 34px;
    }

    .project-modal__panel {
      grid-template-rows: minmax(230px, 38svh) auto;
    }

    .project-modal__details {
      min-height: 360px;
      padding: 22px 18px;
    }

    .project-modal__facts > div {
      grid-template-columns: 68px minmax(0, 1fr);
    }
  }

  @media (max-height: 650px) and (min-width: 761px) {
    .project-modal__panel {
      height: calc(100svh - 32px);
      min-height: 0;
    }

    .project-modal__category {
      margin-top: 22px;
    }

    .project-modal__facts {
      margin-top: 20px;
    }
  }
</style>

<script>
  function mountProjectsSection() {
    document.querySelectorAll<HTMLElement>('.projects-section').forEach((section) => {
      if (section.dataset.mounted === 'true') return;
      section.dataset.mounted = 'true';

      const modal = section.querySelector<HTMLElement>('[data-project-modal]');
      const backdrop = section.querySelector<HTMLElement>('[data-project-modal-backdrop]');
      const closeButton = section.querySelector<HTMLButtonElement>('[data-project-close]');
      const title = section.querySelector<HTMLElement>('[data-project-title]');
      const category = section.querySelector<HTMLElement>('[data-project-category]');
      const subtitle = section.querySelector<HTMLElement>('[data-project-subtitle]');
      const system = section.querySelector<HTMLElement>('[data-project-system]');
      const scope = section.querySelector<HTMLElement>('[data-project-scope]');
      const status = section.querySelector<HTMLElement>('[data-project-status]');
      const statusRow = section.querySelector<HTMLElement>('[data-project-status-row]');
      const mainImage = section.querySelector<HTMLImageElement>('[data-project-main-image]');
      const imageCount = section.querySelector<HTMLElement>('[data-image-count]');
      const gallery = section.querySelector<HTMLElement>('[data-project-gallery]');
      const counter = section.querySelector<HTMLElement>('[data-project-counter]');
      if (!modal || !backdrop || !closeButton || !title || !category || !subtitle || !system || !scope || !status || !statusRow || !mainImage || !imageCount || !gallery || !counter) return;

      let lastTrigger: HTMLElement | null = null;
      let previousBodyOverflow = '';
      let activeImageIndex = -1;
      let imageTransitionToken = 0;
      let currentGalleryImages: string[] = [];
      let currentGalleryPage = 0;
      const galleryPageSize = 10;

      section.querySelectorAll<HTMLButtonElement>('[data-rail-direction]').forEach((control) => {
        control.addEventListener('click', () => {
          const rail = control.closest('.project-group')?.querySelector<HTMLElement>('[data-project-rail]');
          if (!rail) return;
          const direction = Number(control.dataset.railDirection) || 1;
          rail.scrollBy({ left: direction * rail.clientWidth * 0.82, behavior: 'smooth' });
        });
      });

      const setGalleryImage = (images: string[], selectedIndex: number, animate = true) => {
        const imagePath = images[selectedIndex];
        if (!imagePath) return;
        const transitionToken = ++imageTransitionToken;
        const applyImage = () => {
          if (transitionToken !== imageTransitionToken) return;
          mainImage.src = imagePath;
          mainImage.alt = `${title.textContent}, imagen ${selectedIndex + 1}`;
          activeImageIndex = selectedIndex;
          requestAnimationFrame(() => mainImage.classList.remove('is-transitioning'));
        };

        if (!animate || selectedIndex === activeImageIndex) {
          mainImage.classList.remove('is-transitioning');
          applyImage();
        } else {
          mainImage.classList.add('is-transitioning');
          window.setTimeout(applyImage, 180);
        }
        imageCount.textContent = `${String(selectedIndex + 1).padStart(2, '0')} / ${String(images.length).padStart(2, '0')}`;
        gallery.querySelectorAll<HTMLButtonElement>('.project-gallery__thumb').forEach((thumb) => {
          thumb.setAttribute('aria-pressed', String(Number(thumb.dataset.imageIndex) === selectedIndex));
        });
      };

      const renderGalleryPage = (images: string[], requestedPage: number) => {
        const pageCount = Math.max(1, Math.ceil(images.length / galleryPageSize));
        currentGalleryPage = Math.max(0, Math.min(requestedPage, pageCount - 1));
        const firstIndex = currentGalleryPage * galleryPageSize;
        const pageImages = images.slice(firstIndex, firstIndex + galleryPageSize);

        gallery.replaceChildren();
        pageImages.forEach((imagePath, pageIndex) => {
          const imageIndex = firstIndex + pageIndex;
          const thumb = document.createElement('button');
          thumb.className = 'project-gallery__thumb';
          thumb.type = 'button';
          thumb.dataset.imageIndex = String(imageIndex);
          thumb.setAttribute('aria-label', `Ver imagen ${imageIndex + 1} de ${images.length}`);
          thumb.setAttribute('aria-pressed', 'false');
          thumb.addEventListener('click', () => setGalleryImage(images, imageIndex, true));
          const image = document.createElement('img');
          image.src = imagePath;
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          thumb.append(image);
          gallery.append(thumb);
        });

        section.querySelectorAll<HTMLButtonElement>('[data-gallery-page]').forEach((control) => {
          const direction = Number(control.dataset.galleryPage) || 1;
          control.disabled = direction < 0 ? currentGalleryPage === 0 : currentGalleryPage >= pageCount - 1;
          control.hidden = pageCount <= 1;
        });
      };

      section.querySelectorAll<HTMLButtonElement>('[data-gallery-page]').forEach((control) => {
        control.addEventListener('click', () => {
          if (currentGalleryImages.length === 0) return;
          const direction = Number(control.dataset.galleryPage) || 1;
          const page = currentGalleryPage + direction;
          if (page < 0 || page >= Math.ceil(currentGalleryImages.length / galleryPageSize)) return;
          renderGalleryPage(currentGalleryImages, page);
          setGalleryImage(currentGalleryImages, page * galleryPageSize, true);
        });
      });

      const openProject = (trigger: HTMLButtonElement) => {
        let project: {
          title: string;
          subtitle: string;
          system: string;
          scope: string;
          status: string;
          gallery: string[];
        };
        try {
          project = JSON.parse(trigger.dataset.project ?? '') as typeof project;
        } catch {
          return;
        }
        if (!project.gallery.length) return;

        lastTrigger = trigger;
        const groupTitle = trigger.closest('.project-group')?.querySelector('h3')?.textContent?.trim() ?? 'Proyectos';
        title.textContent = project.title;
        category.textContent = groupTitle;
        subtitle.textContent = project.subtitle;
        system.textContent = project.system;
        scope.textContent = project.scope;
        status.textContent = project.status;
        statusRow.hidden = !project.status;
        const allProjects = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-project-card]'));
        const projectIndex = allProjects.indexOf(trigger) + 1;
        counter.textContent = `${String(projectIndex).padStart(2, '0')} / ${String(allProjects.length).padStart(2, '0')}`;

        currentGalleryImages = project.gallery;
        renderGalleryPage(currentGalleryImages, 0);
        activeImageIndex = -1;
        setGalleryImage(currentGalleryImages, 0, false);

        modal.hidden = false;
        previousBodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        document.body.classList.add('has-open-project-modal');
        closeButton.focus();
      };

      const closeProject = () => {
        if (modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = previousBodyOverflow;
        document.body.classList.remove('has-open-project-modal');
        lastTrigger?.focus();
        lastTrigger = null;
      };

      section.querySelectorAll<HTMLButtonElement>('[data-project-card]').forEach((card) => {
        card.addEventListener('click', () => openProject(card));
      });
      closeButton.addEventListener('click', closeProject);
      backdrop.addEventListener('click', closeProject);
      const handleModalKeydown = (event: KeyboardEvent) => {
        if (modal.hidden) return;
        if (event.key === 'Escape') {
          closeProject();
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = Array.from(modal.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]'));
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };
      document.addEventListener('keydown', handleModalKeydown);
      document.addEventListener('astro:before-swap', () => {
        document.removeEventListener('keydown', handleModalKeydown);
        document.body.style.overflow = previousBodyOverflow;
        document.body.classList.remove('has-open-project-modal');
        delete section.dataset.mounted;
      }, { once: true });
    });
  }

  mountProjectsSection();
  document.addEventListener('astro:page-load', mountProjectsSection);
</script>
