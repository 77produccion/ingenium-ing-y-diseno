---
import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import Icon from './Icon.astro';

const getProjectGallery = (folder: string) => {
  const folderFiles = readdirSync(resolve(process.cwd(), 'public', 'assets', 'proyectos', folder), { withFileTypes: true });
  return folderFiles
    .filter((file) => file.isFile() && /\.webp$/i.test(file.name))
    .sort((first, second) => first.name.localeCompare(second.name, 'es', { numeric: true }))
    .map((file) => `/assets/proyectos/${encodeURIComponent(folder)}/${encodeURIComponent(file.name)}`);
};

const residentialProjects = [
  {
    title: 'Casa Tesoro 27 Campestre',
    folder: 'tesoro-27',
    subtitle: 'Vivienda de un piso',
    system: 'Mampostería confinada',
    scope: 'Construcción integral, de principio a fin',
    status: 'Finalizada',
    cover: '/assets/proyectos/tesoro-27/IMG-20250714-WA0011.webp',
    gallery: [],
  },
  {
    title: 'Casa KAAM',
    folder: 'casa-kaam',
    subtitle: 'Vivienda de dos pisos',
    system: 'Mampostería confinada',
    scope: 'Construcción integral, de principio a fin',
    status: 'Finalizada',
    cover: '/assets/proyectos/casa-kaam/20250109_160420.webp',
    gallery: [],
  },
  {
    title: 'Casa Gaia',
    folder: 'casa-diana',
    subtitle: 'Casa Diana Providencia · Vivienda de dos pisos',
    system: 'Demolición y mampostería confinada',
    scope: 'Construcción integral, de principio a fin',
    status: 'Finalizada',
    cover: '/assets/proyectos/casa-diana/DJI_20251118095139_0121_D.webp',
    gallery: [],
  },
  {
    title: 'Casa La Patria Mz 28 Cs 14',
    folder: 'la-patria',
    subtitle: 'Vivienda campestre de dos pisos',
    system: 'Mampostería confinada',
    scope: 'Construcción integral, de principio a fin',
    status: 'Finalizada',
    cover: '/assets/proyectos/la-patria/IMG-20240923-WA0027.webp',
    gallery: [],
  },
  {
    title: 'Casa La Patria Mz 28 Cs 15',
    folder: 'mercamos-la-patria',
    subtitle: 'Vivienda campestre de dos pisos',
    system: 'Mampostería confinada',
