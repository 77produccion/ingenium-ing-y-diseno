---
import { readdirSync } from 'node:fs';
import { resolve } from 'node:path';

const getProjectGallery = (folder: string) => {
  const folderFiles = readdirSync(resolve(process.cwd(), 'public', 'assets', 'proyectos', folder), { withFileTypes: true });
  return folderFiles
    .filter((file) => file.isFile() && /\.webp$/i.test(file.name))
    .sort((first, second) => first.name.localeCompare(second.name, 'es', { numeric: true }))
    .map((file) => `/assets/proyectos/${encodeURIComponent(folder)}/${encodeURIComponent(file.name)}`);
};

