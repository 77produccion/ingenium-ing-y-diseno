    status: 'En ejecución',
    cover: '/assets/proyectos/jorge-castaño/20260523_105641.webp',
    gallery: [],
  },
  {
    title: 'Ampliación Hostal El Viajero',
    folder: 'ampliacion-el-viajero',
    subtitle: 'Salento · Ampliación del segundo piso',
    system: 'Sistema aporticado',
    scope: 'Construcción integral',
    status: 'En ejecución',
    cover: '/assets/proyectos/ampliacion-el-viajero/IMG-20260906-WA0004.webp',
    gallery: [],
  },
  {
    title: 'Subestación Molinos CHEC',
    folder: 'subestacion-chec',
    subtitle: 'Infraestructura energética',
    system: 'Subestación eléctrica',
