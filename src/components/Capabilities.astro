---
const capabilities = [
  {
    index: "A / 01",
    title: "Consultoría integral",
    content: "Planeación del proyecto antes de iniciar obra. Integramos los estudios necesarios para que cada decisión tenga contexto.",
    tags: ["Diseño arquitectónico", "Estructuras", "Redes técnicas", "Licencias y permisos", "Viabilidad económica"],
    defaultOpen: true,
  },
  {
    index: "B / 02",
    title: "Construcción",
    content: "Ejecución de proyectos propios o diseñados por terceros, con supervisión del equipo técnico y una red de contratistas aliados.",
    tags: ["Vivienda", "Comercial", "Institucional", "Remodelación", "Obra civil"],
    defaultOpen: false,
  },
  {
    index: "C / 03",
    title: "Acompañamiento técnico",
    content: "Claridad para equipos y propietarios en las etapas de decisión, coordinación y seguimiento técnico del proyecto.",
    tags: ["Coordinación", "Revisión técnica", "Seguimiento"],
    defaultOpen: false,
  }
];
---

<section class="capabilities" id="servicios" data-header-theme="light">
  <div class="cap-head">
    <div class="section-id mono">[ 02 — CAPACIDADES ]</div>
    <h2>
      Visión integral.<br />
      <span>Detalle especializado.</span>
    </h2>
    <p>Una ruta técnica que pone en relación diseño, normativa, inversión y ejecución.</p>
  </div>

  <div class="cap-list">
    {capabilities.map((cap) => (
      <article class="cap-item">
        <button aria-expanded={cap.defaultOpen ? "true" : "false"} type="button">
          <span class="cap-index mono">{cap.index}</span>
          <span class="cap-title">{cap.title}</span>
          <span class="cap-symbol">{cap.defaultOpen ? "−" : "+"}</span>
        </button>
        <div class="cap-content" hidden={!cap.defaultOpen}>
          <p>{cap.content}</p>
          <div class="tags">
            {cap.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
