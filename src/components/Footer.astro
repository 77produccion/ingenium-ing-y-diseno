---
const homePrefix = Astro.url.pathname === '/' ? '' : '/';
---

<footer class="footer" data-header-theme="dark">
  <div class="footer-main" data-reveal-children data-reveal-style="rise">
    <div class="footer-brand">
      <a class="footer-brand-link" href={`${homePrefix}#inicio`} aria-label="INGENIUM — Inicio">
        <img
          src="/assets/logos/021026 INGENIUM - LOGO_2026-02.webp"
          alt="INGENIUM — Ingeniería & Diseño"
          class="footer-brand-img"
        />
      </a>
      <p>Ingeniería que escucha.<br />Diseño que resuelve.</p>
      <div class="footer-socials" aria-label="Redes sociales de INGENIUM">
        <a href="https://www.facebook.com/people/Ingenium-Ingenier%C3%ADa-Dise%C3%B1o/61571403733058/#" target="_blank" rel="noreferrer" aria-label="Facebook de INGENIUM">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v1.8H7.6v2.8h2.6V21h3.3Z" fill="currentColor" /></svg>
        </a>
        <a href="https://www.instagram.com/ingenium.inf?stkn=MXdnMnpkZjk1ZDRwdg%3D%3D" target="_blank" rel="noreferrer" aria-label="Instagram de INGENIUM">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.25" y="3.25" width="17.5" height="17.5" rx="5.1" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.75" cy="6.5" r="1.15" fill="currentColor" /></svg>
        </a>
      </div>
    </div>

    <div class="footer-location">
      <h2>Ubicación</h2>
      <address>
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 10.2c0 5-7 11-7 11s-7-6-7-11a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.2" /></svg>
        <span>Cl 13 N #11-13<br />Oficina 703<br />Armenia, Quindío</span>
      </address>
      <a class="footer-map-link" href="https://maps.google.com/?q=Cl+13+N+11-13+Oficina+703+Armenia+Quindio" target="_blank" rel="noreferrer">Ver ubicación <span aria-hidden="true">↗</span></a>
    </div>

    <div class="footer-contact">
      <h2>Hablemos</h2>
      <a class="footer-contact__link" href="tel:+573244934941">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5H4.9c-.8 0-1.4.7-1.3 1.5.7 8.2 7.2 14.7 15.4 15.4.8.1 1.5-.5 1.5-1.3v-2.3c0-.7-.5-1.3-1.2-1.4l-3.1-.5c-.5-.1-1 .1-1.4.5l-1.4 1.4a15.6 15.6 0 0 1-6.7-6.7l1.4-1.4c.4-.4.6-.9.5-1.4l-.5-3.1c-.1-.7-.7-1.2-1.4-1.2Z" /></svg>
        <span>+57 324 493 4941</span>
      </a>
      <a class="footer-contact__link" href="https://api.whatsapp.com/send?phone=573244934941" target="_blank" rel="noreferrer">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a8 8 0 0 1-11.8 7L4 20l1.3-4A8 8 0 1 1 20 11.7Z" /><path d="M9 8.1c.3-.4.6-.4.8-.1l1 1.6c.1.2.1.5-.1.7l-.5.6c.6 1.1 1.4 1.9 2.6 2.5l.6-.6c.2-.2.5-.3.7-.1l1.6.9c.3.2.3.6.1.9-.5.7-1.2 1-2 1-2.5-.2-5.7-3.2-5.9-5.8-.1-.7.3-1.3 1.1-1.6Z" /></svg>
        <span>Escríbenos por WhatsApp</span>
      </a>
      <a class="footer-contact__link" href="mailto:hola@ingenium.com.co">
        <svg class="footer-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></svg>
        <span>hola@ingenium.com.co</span>
      </a>
    </div>

    <nav class="footer-nav" aria-label="Enlaces rápidos">
      <h2>Explora</h2>
      <a href="/nosotros">Nosotros</a>
      <a href={`${homePrefix}#servicios`}>Servicios</a>
      <a href={`${homePrefix}#proyectos`}>Proyectos</a>
      <a href={`${homePrefix}#equipo`}>Equipo</a>
      <a href={`${homePrefix}#contacto`}>Contacto</a>
    </nav>
  </div>

  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} INGENIUM Ingeniería & Diseño SAS</span>
    <div>
      <a href={`${homePrefix}#inicio`}>Volver arriba <span aria-hidden="true">↑</span></a>
      <a href={`${homePrefix}#contacto`}>Conversemos sobre tu proyecto <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</footer>
