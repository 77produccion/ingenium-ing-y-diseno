---
interface Props {
  src: string;
  duration?: number;
  hold?: number;
  fadeDuration?: number;
  autoplay?: boolean;
  label?: string;
}

const {
  src,
  duration = 4.5,
  hold = 0.6,
  fadeDuration = 0.8,
  autoplay = true,
  label = "Dibujo técnico animado",
} = Astro.props;
---

<div
  class="animated-technical-drawing"
  data-src={src}
  data-duration={duration}
  data-hold={hold}
  data-fade-duration={fadeDuration}
  data-autoplay={autoplay}
  role="img"
  aria-label={label}
></div>

<style>
  .animated-technical-drawing {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 1px;
  }

  .animated-technical-drawing :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>

<script>
  import { gsap } from "gsap";

  type DrawingElement = HTMLDivElement & {
    play: () => gsap.core.Timeline | undefined;
    restart: () => gsap.core.Timeline | undefined;
    reset: () => void;
  };

  async function mountDrawing(host: HTMLDivElement) {
    if (host.dataset.mounted === "true") return;
    host.dataset.mounted = "true";

    try {
      const response = await fetch(host.dataset.src ?? "");
      if (!response.ok) throw new Error(`No se pudo cargar el SVG (${response.status})`);
      const markup = await response.text();
      const document = new DOMParser().parseFromString(markup, "image/svg+xml");
      const svg = document.documentElement;
      if (svg.localName !== "svg" || document.querySelector("parsererror")) {
        throw new Error("El archivo cargado no contiene un SVG válido");
      }

      const inlineSvg = window.document.importNode(svg, true);
      host.replaceChildren(inlineSvg);
      const strokes = Array.from(
        inlineSvg.querySelectorAll<SVGGeometryElement>(
          ".draw-stroke, path, line, polyline, polygon, circle, ellipse",
        ),
      );
      const totalDuration = Number(host.dataset.duration) || 4.5;
      const hold = Number(host.dataset.hold) || 0.6;
      const fadeDuration = Number(host.dataset.fadeDuration) || 0.8;

      const measured = strokes
        .map((stroke) => {
          try {
            const length = stroke.getTotalLength();
            const box = stroke.getBBox();
            return { stroke, length, bottom: box.y + box.height };
          } catch {
            return null;
          }
        })
        .filter((entry): entry is { stroke: SVGGeometryElement; length: number; bottom: number } =>
          Boolean(entry && Number.isFinite(entry.length) && entry.length > 0),
        )
        .sort((a, b) => b.bottom - a.bottom);

      for (const { stroke, length } of measured) {
        stroke.style.strokeDasharray = `${length} ${length}`;
        stroke.style.strokeDashoffset = `${length}`;
      }
      gsap.set(inlineSvg, { opacity: 1 });

      const timeline = gsap.timeline({ paused: true });
      const strokeDuration = Math.min(0.18, totalDuration / 8);
      const stagger = measured.length > 1
        ? Math.max(0, (totalDuration - strokeDuration) / (measured.length - 1))
        : 0;
      if (measured.length) {
        timeline.to(
          measured.map(({ stroke }) => stroke),
          {
            strokeDashoffset: 0,
            duration: strokeDuration,
            ease: "none",
            stagger,
          },
        );
      }
      timeline.to(inlineSvg, { opacity: 0, duration: fadeDuration, ease: "power1.inOut" }, `>${hold}`);

      const drawing = host as DrawingElement;
      drawing.play = () => timeline.play();
      drawing.reset = () => {
        timeline.pause(0);
        gsap.set(inlineSvg, { opacity: 1 });
      };
      drawing.restart = () => {
        drawing.reset();
        return timeline.play(0);
      };

      if (host.dataset.autoplay === "true") drawing.play();
      host.dispatchEvent(new CustomEvent("drawingready", { bubbles: true, detail: drawing }));
    } catch (error) {
      host.dataset.error = error instanceof Error ? error.message : "Error al cargar el dibujo";
      host.dispatchEvent(new CustomEvent("drawingerror", { bubbles: true, detail: error }));
    }
  }

  document.querySelectorAll<HTMLDivElement>(".animated-technical-drawing").forEach(mountDrawing);
</script>
