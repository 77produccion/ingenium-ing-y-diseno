---
import BlueprintModule from "./BlueprintModule.astro";
---

<section class="narrative-section" id="proyectos" data-header-theme="dark" aria-label="La filosofía de INGENIUM">
  <div class="narrative-stage">
    <div class="narrative-grid" aria-hidden="true"></div>

    <div class="narrative-layer narrative-intro" data-intro-layer>
      <div class="narrative-intro__content">
        <img
          class="narrative-intro__logo"
          src="/assets/logos/021026 INGENIUM - LOGO_2026-02.png"
          alt="INGENIUM — Ingeniería y Diseño"
          width="600"
          height="240"
          decoding="async"
        />
        <p class="narrative-intro__eyebrow mono">PENSAMIENTO · INGENIERÍA · OBRA</p>
        <h2 class="narrative-intro__statement">
          Las estructuras no se comportan como se diseñan, sino como se construyen.
        </h2>
      </div>
      <span class="narrative-coordinate narrative-coordinate--intro mono" aria-hidden="true">INGENIUM / 01</span>
    </div>

    <div class="narrative-layer narrative-blueprint-layer" data-blueprint-layer aria-hidden="true">
      <BlueprintModule />
      <p class="narrative-blueprint-caption mono">DEL PENSAMIENTO A LA ESTRUCTURA</p>
    </div>

    <div class="narrative-layer narrative-philosophy" data-philosophy-layer>
      <div class="narrative-philosophy__heading">
        <p class="narrative-philosophy__eyebrow mono">CRITERIOS DE DISEÑO</p>
        <h2>Una estructura. Cuatro principios.</h2>
      </div>

      <div class="narrative-cards" aria-label="Principios de trabajo de INGENIUM">
        <article class="narrative-card" data-philosophy-card>
          <span class="narrative-card__number mono" data-card-number>01 <i></i></span>
          <div data-card-content>
            <h3>INGENIO APLICADO</h3>
            <p>Pensar para resolver.</p>
          </div>
        </article>
        <article class="narrative-card" data-philosophy-card>
          <span class="narrative-card__number mono" data-card-number>02 <i></i></span>
          <div data-card-content>
            <h3>DISEÑAR PARA OPTIMIZAR</h3>
            <p>Decidir antes de ejecutar.</p>
          </div>
        </article>
        <article class="narrative-card" data-philosophy-card>
          <span class="narrative-card__number mono" data-card-number>03 <i></i></span>
          <div data-card-content>
            <h3>DISEÑAR PARA CONSTRUIR</h3>
            <p>Del cálculo a la realidad.</p>
          </div>
        </article>
        <article class="narrative-card" data-philosophy-card>
          <span class="narrative-card__number mono" data-card-number>04 <i></i></span>
          <div data-card-content>
            <h3>RIGOR QUE GENERA CONFIANZA</h3>
            <p>Hacerlo bien desde el principio.</p>
          </div>
        </article>
      </div>
      <span class="narrative-coordinate narrative-coordinate--philosophy mono" aria-hidden="true">INGENIUM / 02</span>
    </div>

    <span class="narrative-progress mono" data-narrative-progress aria-hidden="true">00</span>
  </div>
</section>

<style>
  .narrative-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
    color: var(--bg);
    background: var(--brand-navy);
    isolation: isolate;
  }

  .narrative-stage {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background:
      linear-gradient(90deg, transparent 49.96%, rgba(246, 243, 236, 0.045) 50%, transparent 50.04%),
      linear-gradient(0deg, transparent 49.96%, rgba(246, 243, 236, 0.045) 50%, transparent 50.04%),
      var(--brand-navy);
  }

  .narrative-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.22;
    background-image: linear-gradient(rgba(246, 243, 236, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(246, 243, 236, 0.04) 1px, transparent 1px);
    background-size: 88px 88px;
    pointer-events: none;
  }

  .narrative-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .narrative-intro {
    display: grid;
    align-items: center;
    padding: clamp(88px, 12svh, 132px) clamp(28px, 6vw, 100px) clamp(54px, 8svh, 88px);
  }

  .narrative-intro__content {
    width: min(100%, 1440px);
    margin-inline: auto;
  }

  .narrative-intro__logo {
    display: block;
    width: clamp(150px, 11vw, 190px);
    height: auto;
    margin-bottom: clamp(34px, 5svh, 54px);
    object-fit: contain;
  }

  .narrative-intro__eyebrow,
  .narrative-philosophy__eyebrow {
    margin: 0 0 18px;
    color: rgba(246, 243, 236, 0.62);
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  .narrative-intro__statement {
    max-width: 790px;
    margin: 0;
    color: var(--bg);
    font: 500 clamp(42px, 4.5vw, 76px) / 1.08 var(--font-heading);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .narrative-coordinate {
    position: absolute;
    color: rgba(246, 243, 236, 0.46);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .narrative-coordinate--intro,
  .narrative-coordinate--philosophy {
    right: max(24px, calc((100vw - 1440px) / 2));
    bottom: 30px;
  }

  .narrative-blueprint-layer {
    display: grid;
    place-items: center;
  }

  .narrative-blueprint-caption {
    position: absolute;
    right: max(24px, calc((100vw - 1440px) / 2));
    bottom: 30px;
    margin: 0;
    color: rgba(246, 243, 236, 0.62);
    font-size: 10px;
    letter-spacing: 0.13em;
  }

  .narrative-philosophy {
    display: grid;
    align-content: center;
    padding: clamp(92px, 12svh, 128px) clamp(28px, 6vw, 100px) clamp(66px, 8svh, 88px);
  }

  .narrative-philosophy__heading {
    position: relative;
    z-index: 2;
    width: min(100%, 1160px);
    margin: 0 auto clamp(24px, 4svh, 38px);
  }

  .narrative-philosophy__heading h2 {
    max-width: 860px;
    margin: 0;
    color: var(--bg);
    font: 500 clamp(34px, 3.8vw, 56px) / 1.08 var(--font-heading);
    letter-spacing: -0.04em;
  }

  .narrative-cards {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 22px);
    width: min(100%, 1160px);
    margin-inline: auto;
  }

  .narrative-card {
    position: relative;
    min-height: clamp(156px, 20svh, 204px);
    padding: clamp(21px, 2.4vw, 34px);
    border: 1px solid rgba(246, 243, 236, 0.24);
    background: rgba(20, 37, 70, 0.74);
    will-change: transform, opacity;
  }

  .narrative-card::before {
    position: absolute;
    top: -1px;
    left: -1px;
    width: clamp(42px, 5vw, 72px);
    height: 2px;
    content: "";
    background: var(--accent);
  }

  .narrative-card__number {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(24px, 3svh, 38px);
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .narrative-card__number i {
    display: block;
    width: clamp(46px, 6vw, 90px);
    height: 1px;
    background: rgba(235, 113, 39, 0.72);
  }

  .narrative-card h3 {
    margin: 0 0 10px;
    color: var(--bg);
    font: 600 clamp(16px, 1.55vw, 21px) / 1.25 var(--font-heading);
    letter-spacing: 0.01em;
  }

  .narrative-card p {
    margin: 0;
    color: rgba(246, 243, 236, 0.7);
    font-size: clamp(13px, 1.1vw, 15px);
  }

  .narrative-progress {
    position: absolute;
    z-index: 5;
    right: max(24px, calc((100vw - 1440px) / 2));
    bottom: 28px;
    color: rgba(246, 243, 236, 0.48);
    font-size: 9px;
    letter-spacing: 0.12em;
    pointer-events: none;
    display: none;
  }

  .narrative-blueprint-layer,
  .narrative-philosophy {
    visibility: hidden;
  }

  .narrative-section[data-motion-enhanced="true"] .narrative-progress {
    display: block;
  }

  @media (max-width: 700px) {
    .narrative-intro {
      padding: 100px 7vw 72px;
    }

    .narrative-intro__logo {
      width: 150px;
      margin-bottom: 38px;
    }

    .narrative-intro__eyebrow,
    .narrative-philosophy__eyebrow {
      font-size: 8px;
    }

    .narrative-intro__statement {
      max-width: 560px;
      font-size: clamp(39px, 10vw, 54px);
    }

    .narrative-philosophy {
      align-content: center;
      padding: 90px 6vw 66px;
    }

    .narrative-philosophy__heading {
      margin-bottom: 22px;
    }

    .narrative-philosophy__heading h2 {
      max-width: 400px;
      font-size: clamp(31px, 8vw, 43px);
    }

    .narrative-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .narrative-card {
      min-height: clamp(142px, 19svh, 174px);
      padding: 16px 13px;
    }

    .narrative-card__number {
      gap: 7px;
      margin-bottom: 22px;
      font-size: 10px;
    }

    .narrative-card__number i {
      width: 25px;
    }

    .narrative-card h3 {
      font-size: clamp(12px, 3.3vw, 16px);
    }

    .narrative-card p {
      font-size: 12px;
      line-height: 1.4;
    }

    .narrative-progress {
      right: 6vw;
      bottom: 21px;
    }

    .narrative-blueprint-caption {
      right: 7vw;
      bottom: 22px;
      font-size: 8px;
    }
  }

  @media (max-height: 720px) and (min-width: 701px) {
    .narrative-philosophy {
      padding-top: 82px;
      padding-bottom: 50px;
    }

    .narrative-philosophy__heading {
      margin-bottom: 18px;
    }

    .narrative-card {
      min-height: 124px;
      padding-block: 20px;
    }

    .narrative-card__number {
      margin-bottom: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .narrative-section {
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .narrative-stage {
      display: grid;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .narrative-layer {
      position: relative;
      inset: auto;
      display: block;
      width: 100%;
      height: auto;
      min-height: 0;
      padding: 72px clamp(24px, 6vw, 88px);
      visibility: visible;
    }

    .narrative-intro {
      display: grid;
      padding-top: 112px;
    }

    .narrative-intro__statement {
      font-size: clamp(34px, 8vw, 60px);
    }

    .narrative-blueprint-layer {
      display: grid;
      min-height: 480px;
    }

    .narrative-blueprint-layer {
      visibility: visible;
    }

    .narrative-philosophy {
      display: block;
    }

    .narrative-blueprint__frame {
      width: min(72vw, 760px);
      height: min(68svh, 620px);
    }

    .narrative-cards {
      margin-top: 30px;
    }

    .narrative-card {
      min-height: 156px;
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }

    .narrative-card [data-card-number],
    .narrative-card [data-card-content] {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }

    .narrative-progress {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { createBlueprintTimeline } from "../scripts/narrative/blueprintTimeline";
  import { createPhilosophyTimeline } from "../scripts/narrative/philosophyTimeline";

  gsap.registerPlugin(ScrollTrigger);

  const mountedSections = new Map<HTMLElement, gsap.MatchMedia>();

  function mountNarrative() {
    document.querySelectorAll<HTMLElement>(".narrative-section").forEach((section) => {
      if (mountedSections.has(section)) return;

      const media = gsap.matchMedia(section);
      mountedSections.set(section, media);

      media.add("(prefers-reduced-motion: no-preference)", () => {
        const context = gsap.context(() => {
          const stage = section.querySelector<HTMLElement>(".narrative-stage");
          const intro = section.querySelector<HTMLElement>("[data-intro-layer]");
          const blueprintRoot = section.querySelector<HTMLElement>("[data-blueprint]");
          const blueprintLayer = section.querySelector<HTMLElement>("[data-blueprint-layer]");
          const philosophy = section.querySelector<HTMLElement>("[data-philosophy-layer]");
          const progressOutput = section.querySelector<HTMLElement>("[data-narrative-progress]");
          const blueprintImage = section.querySelector<HTMLImageElement>(".narrative-blueprint__drawing");

          if (!stage || !intro || !blueprintRoot || !blueprintLayer || !philosophy) return;

          gsap.set(blueprintLayer, { autoAlpha: 0 });
          gsap.set(philosophy, { autoAlpha: 0 });
          gsap.set(section.querySelectorAll("[data-philosophy-card]"), {
            autoAlpha: 0,
            y: 22,
            scale: 0.985,
          });

          const master = gsap.timeline({
            defaults: { ease: "none" },
            scrollTrigger: {
              trigger: section,
              start: "top top",
              end: () => `+=${window.innerHeight * (window.matchMedia("(max-width: 700px)").matches ? 5.5 : 4.8)}`,
              pin: section,
              pinSpacing: true,
              scrub: 1,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              markers: import.meta.env.DEV ? {
                startColor: "#eb7127",
                endColor: "#eb7127",
                fontSize: "10px",
              } : false,
              onUpdate: (self) => {
                if (progressOutput) progressOutput.textContent = `${Math.round(self.progress * 100).toString().padStart(2, "0")}`;
              },
            },
          });

          master.addLabel("intro", 0);
          master.addLabel("introComplete", 16);
          master.addLabel("blueprintEnter", 16);
          master.addLabel("blueprintStart", 25);
          master.addLabel("blueprintComplete", 57);
          master.addLabel("philosophyStart", 61);
          master.addLabel("card01", 62);
          master.addLabel("card02", 69);
          master.addLabel("card03", 76);
          master.addLabel("card04", 83);
          master.addLabel("philosophyComplete", 92);
          master.addLabel("finalHold", 100);

          master.to(intro, { autoAlpha: 0, y: -24, scale: 0.985, duration: 9 }, "blueprintEnter");
          master.to(blueprintLayer, { autoAlpha: 1, duration: 9 }, "blueprintEnter");

          const blueprintTimeline = createBlueprintTimeline(blueprintRoot);
          master.add(blueprintTimeline, "blueprintStart");

          master.to(philosophy, { autoAlpha: 1, duration: 1 }, "philosophyStart");
          master.to(blueprintLayer, { autoAlpha: 0.14, duration: 5 }, "philosophyStart");
          const philosophyTimeline = createPhilosophyTimeline(philosophy);
          master.add(philosophyTimeline, "philosophyStart+=1");
          master.to({}, { duration: 8 }, "philosophyComplete");

          section.dataset.motionEnhanced = "true";
          ScrollTrigger.refresh();

          void document.fonts.ready.then(() => ScrollTrigger.refresh());
          if (blueprintImage) {
            void blueprintImage.decode().then(() => ScrollTrigger.refresh()).catch(() => undefined);
          }
        }, section);

        return () => {
          delete section.dataset.motionEnhanced;
          context.revert();
        };
      });
    });
  }

  function unmountNarrative() {
    mountedSections.forEach((media) => media.revert());
    mountedSections.clear();
  }

  mountNarrative();
  document.addEventListener("astro:page-load", mountNarrative);
  document.addEventListener("astro:before-swap", unmountNarrative);
  import.meta.hot?.dispose(unmountNarrative);
</script>
