---
const gridViewWidth = 1600;
const gridViewHeight = 900;
const gridHorizon = 560;
const vanishingPoint = gridViewWidth / 2;

const perspectiveRays = Array.from({ length: 25 }, (_, index) => {
  const fraction = index / 24;
  const floorX = -160 + fraction * 1920;
  const horizonX = vanishingPoint + (floorX - vanishingPoint) * 0.14;
  return `M ${horizonX.toFixed(1)} ${gridHorizon} L ${floorX.toFixed(1)} ${gridViewHeight}`;
});

const perspectiveRows = Array.from({ length: 12 }, (_, index) => {
  const fraction = (index + 1) / 12;
  const y = gridHorizon + (gridViewHeight - gridHorizon) * Math.pow(fraction, 2.1);
  return `M 0 ${y.toFixed(1)} H ${gridViewWidth}`;
});

const introDrawings = [
  { src: "/drawings/edificio-calle-39-3.svg", alt: "Dibujo técnico de un edificio urbano" },
  { src: "/drawings/casa-el-carmelo-4.svg", alt: "Dibujo técnico de una vivienda" },
  { src: "/drawings/casa-el-carmelo-3.svg", alt: "Dibujo técnico estructural de una vivienda" },
  { src: "/drawings/torre-macura-3.svg", alt: "Dibujo técnico de Torre Macura" },
];
---

<section class="narrative-section" id="proyectos" data-header-theme="light" aria-label="La filosofía de INGENIUM">
  <div class="narrative-stage">
    <div class="narrative-layer narrative-intro" data-intro-layer>
      <div class="narrative-intro__content">
        <div class="narrative-intro__logo-frame">
          <img
            class="narrative-intro__logo"
            src="/assets/logos/021026 INGENIUM - LOGO_2026-01.png"
            alt="INGENIUM — Ingeniería y Diseño"
            width="2000"
            height="2000"
            decoding="async"
          />
        </div>
        <h2 class="narrative-intro__statement">
          Las estructuras no se comportan como se diseñan, sino como se construyen.
        </h2>
      </div>
      <ul class="narrative-intro__drawings" aria-label="Dibujos técnicos de proyectos INGENIUM">
        {introDrawings.map((drawing) => (
          <li
            class="narrative-intro__drawing"
            role="img"
            aria-label={drawing.alt}
            style={`--drawing-mask: url('${drawing.src}')`}
          ></li>
        ))}
      </ul>
    </div>

    <div class="narrative-layer narrative-philosophy" data-philosophy-layer>
      <div class="narrative-paper" data-paper>
        <svg
          class="narrative-paper__grid"
          data-perspective-grid
          viewBox={`0 0 ${gridViewWidth} ${gridViewHeight}`}
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <path class="narrative-paper__grid-line narrative-paper__grid-line--horizon" data-perspective-line d={`M 0 ${gridHorizon} H ${gridViewWidth}`} />
          {perspectiveRows.map((path) => (
            <path class="narrative-paper__grid-line" data-perspective-line d={path} />
          ))}
          {perspectiveRays.map((path) => (
            <path class="narrative-paper__grid-line" data-perspective-line d={path} />
          ))}
        </svg>
        <span class="narrative-paper__edge" data-paper-edge aria-hidden="true"></span>
        <div class="narrative-paper__content">
          <h2>Una estructura. Cuatro principios.</h2>

          <div class="narrative-cards" aria-label="Principios de trabajo de INGENIUM">
            <article class="narrative-card" data-philosophy-card>
              <div class="narrative-card__image" aria-hidden="true"></div>
              <div class="narrative-card__body">
                <span class="narrative-card__number" data-card-number>01</span>
                <div data-card-content>
                  <h3>INGENIO APLICADO</h3>
                  <p>Pensar para resolver.</p>
                </div>
              </div>
            </article>
            <article class="narrative-card" data-philosophy-card>
              <div class="narrative-card__image" aria-hidden="true"></div>
              <div class="narrative-card__body">
                <span class="narrative-card__number" data-card-number>02</span>
                <div data-card-content>
                  <h3>DISEÑAR PARA OPTIMIZAR</h3>
                  <p>Decidir antes de ejecutar.</p>
                </div>
              </div>
            </article>
            <article class="narrative-card" data-philosophy-card>
              <div class="narrative-card__image" aria-hidden="true"></div>
              <div class="narrative-card__body">
                <span class="narrative-card__number" data-card-number>03</span>
                <div data-card-content>
                  <h3>DISEÑAR PARA CONSTRUIR</h3>
                  <p>Del cálculo a la realidad.</p>
                </div>
              </div>
            </article>
            <article class="narrative-card" data-philosophy-card>
              <div class="narrative-card__image" aria-hidden="true"></div>
              <div class="narrative-card__body">
                <span class="narrative-card__number" data-card-number>04</span>
                <div data-card-content>
                  <h3>RIGOR QUE GENERA CONFIANZA</h3>
                  <p>Hacerlo bien desde el principio.</p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .narrative-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 100svh;
    overflow: hidden;
    color: var(--brand-navy);
    background: var(--bg);
    isolation: isolate;
  }

  .narrative-stage {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--bg);
  }

  .narrative-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .narrative-intro {
    z-index: 1;
    display: grid;
    align-content: start;
    padding: clamp(156px, 19svh, 204px) clamp(28px, 6vw, 100px) clamp(32px, 4svh, 48px);
  }

  .narrative-intro__content {
    display: grid;
    grid-template-columns: minmax(220px, 0.44fr) minmax(0, 1.5fr);
    align-items: center;
    gap: clamp(48px, 7vw, 112px);
    width: min(100%, 1440px);
    margin-inline: auto;
  }

  .narrative-intro__logo-frame {
    position: relative;
    width: min(100%, 300px);
    height: auto;
    aspect-ratio: 1 / 1;
    margin-left: -10px;
  }

  .narrative-intro__logo {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .narrative-intro__statement {
    max-width: 920px;
    margin: 0;
    color: var(--brand-navy);
    font: 700 clamp(38px, 3.2vw, 64px) / 1.12 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .narrative-intro__drawings {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    justify-content: space-between;
    gap: clamp(24px, 4vw, 64px);
    width: min(100%, 1440px);
    margin: clamp(26px, 4svh, 42px) auto 0;
    padding: 0;
    list-style: none;
  }

  .narrative-intro__drawing {
    display: block;
    height: clamp(210px, 35svh, 330px);
    min-width: 0;
    background-color: var(--brand-navy);
    -webkit-mask-image: var(--drawing-mask);
    mask-image: var(--drawing-mask);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .narrative-philosophy {
    z-index: 2;
    visibility: hidden;
  }

  .narrative-paper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--bg);
    background: var(--panel-dark);
    border-left: 1px solid rgba(246, 243, 236, 0.18);
    box-shadow: -18px 0 36px rgba(10, 16, 14, 0.32);
    clip-path: inset(0 100% 0 0);
    transform: scaleX(0.99);
    transform-origin: left center;
  }

  .narrative-paper__grid {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    color: #7085b0;
    mask-image: linear-gradient(180deg, transparent 56%, rgba(0, 0, 0, 0.22) 64%, #000 78%);
    pointer-events: none;
  }

  .narrative-paper__grid-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35px;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .narrative-paper__grid-line--horizon {
    stroke-width: 1.6px;
  }

  .narrative-paper__edge {
    position: absolute;
    z-index: 2;
    inset: 0 auto 0 0;
    width: clamp(22px, 3vw, 44px);
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.38), rgba(246, 243, 236, 0.1) 42%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .narrative-paper__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(calc(100% - clamp(40px, 12vw, 192px)), 1440px);
    height: 100%;
    margin-inline: auto;
    padding-block: clamp(76px, 10svh, 116px);
  }

  .narrative-paper__content > h2 {
    margin: 0 0 clamp(22px, 3svh, 34px);
    color: var(--bg);
    font: 700 clamp(30px, 3vw, 46px) / 1.12 var(--font-heading);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .narrative-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 30px);
  }

  .narrative-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    height: auto;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(246, 243, 236, 0.2);
    border-radius: 16px;
    background: var(--bg);
    will-change: transform, opacity;
  }

  .narrative-card__image {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    height: clamp(124px, min(30svh, 22vw), 270px);
    background: var(--bg-subtle);
    border-radius: 15px 15px 13px 13px;
  }

  .narrative-card__body {
    display: flex;
    min-height: 0;
    flex: 1 0 auto;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(10px, 1.15vw, 16px);
    padding: clamp(14px, 1.45vw, 22px);
  }

  .narrative-card__number {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--accent);
    font: 700 clamp(18px, 1.8vw, 24px) / 1 var(--font-heading);
  }

  .narrative-card__number::after {
    width: clamp(22px, 2.5vw, 38px);
    height: 2px;
    background: var(--accent);
    content: "";
  }

  .narrative-card h3 {
    max-width: 20ch;
    margin: 0 0 8px;
    color: var(--brand-navy);
    font: 700 clamp(15px, 1.3vw, 19px) / 1.2 var(--font-heading);
    letter-spacing: -0.015em;
  }

  .narrative-card p {
    max-width: 24ch;
    margin: 0;
    color: var(--ink-secondary);
    font: 400 clamp(14px, 1vw, 16px) / 1.4 var(--font-body);
  }

  @media (max-width: 700px) {
    .narrative-intro {
      padding: 112px 7vw 44px;
    }

    .narrative-intro__content {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .narrative-intro__logo-frame {
      width: clamp(180px, 50vw, 230px);
      height: auto;
      aspect-ratio: 1 / 1;
      margin-bottom: 19px;
    }

    .narrative-intro__statement {
      max-width: 620px;
      font-size: clamp(35px, 8.5vw, 46px);
    }

    .narrative-intro__drawings {
      width: calc(100% + 14vw);
      gap: 6px;
      margin-top: 26px;
      margin-inline: -7vw;
    }

    .narrative-intro__drawing {
      height: clamp(95px, 16svh, 136px);
    }

    .narrative-paper__content {
      width: calc(100% - 36px);
      padding-block: 58px;
    }

    .narrative-paper__content > h2 {
      max-width: 360px;
      margin-bottom: 20px;
      font-size: clamp(27px, 6.7vw, 35px);
    }

    .narrative-card {
      height: auto;
    }

    .narrative-card__image {
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .narrative-card__body {
      gap: 9px;
      padding: 12px 9px;
    }

    .narrative-card__number {
      gap: 6px;
      font-size: 16px;
    }

    .narrative-card__number::after {
      width: 14px;
      height: 1px;
    }

    .narrative-card h3 {
      margin-bottom: 8px;
      font-size: clamp(10px, 2.9vw, 13px);
      line-height: 1.13;
      overflow-wrap: anywhere;
    }

    .narrative-card p {
      font-size: clamp(9px, 2.5vw, 11px);
      line-height: 1.3;
      overflow-wrap: anywhere;
    }

    .narrative-paper__grid-line {
      stroke-width: 1px;
    }
  }

  @media (max-height: 720px) and (min-width: 701px) {
    .narrative-intro {
      padding-top: 80px;
      padding-bottom: 18px;
    }

    .narrative-intro__logo-frame {
      width: clamp(150px, 16vw, 180px);
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .narrative-intro__statement {
      font-size: clamp(30px, 3vw, 40px);
    }

    .narrative-intro__drawings {
      gap: 18px;
      margin-top: 20px;
    }

    .narrative-intro__drawing {
      height: clamp(140px, 28svh, 170px);
    }

    .narrative-paper__content {
      padding-block: 40px;
    }

    .narrative-paper__content > h2 {
      margin-bottom: 14px;
      font-size: clamp(26px, 3vw, 36px);
    }

    .narrative-card {
      height: auto;
    }

    .narrative-card__body {
      gap: 8px;
      padding: 13px;
    }

    .narrative-card h3 {
      font-size: clamp(14px, 1.2vw, 17px);
    }

    .narrative-card p {
      font-size: clamp(13px, 0.95vw, 14px);
    }

    .narrative-card__image {
      height: clamp(112px, 27svh, 190px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .narrative-card {
      will-change: auto;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { createPhilosophyTimeline } from "../scripts/narrative/philosophyTimeline";

  gsap.registerPlugin(ScrollTrigger);

  const mountedSections = new Map<HTMLElement, gsap.MatchMedia>();

  function mountNarrative() {
    document.querySelectorAll<HTMLElement>(".narrative-section").forEach((section) => {
      if (mountedSections.has(section)) return;

      const media = gsap.matchMedia(section);
      mountedSections.set(section, media);

      media.add({
        reducedMotion: "(prefers-reduced-motion: reduce)",
        standardMotion: "(prefers-reduced-motion: no-preference)",
      }, (mediaContext) => {
        const context = gsap.context(() => {
          const reducedMotion = Boolean(mediaContext.conditions?.reducedMotion);
          const intro = section.querySelector<HTMLElement>("[data-intro-layer]");
          const philosophy = section.querySelector<HTMLElement>("[data-philosophy-layer]");
          const paper = section.querySelector<HTMLElement>("[data-paper]");
          const paperEdge = section.querySelector<HTMLElement>("[data-paper-edge]");
          const perspectiveGrid = section.querySelector<SVGSVGElement>("[data-perspective-grid]");
          const perspectiveLines = perspectiveGrid
            ? Array.from(perspectiveGrid.querySelectorAll<SVGPathElement>("[data-perspective-line]"))
            : [];
          const cards = section.querySelectorAll<HTMLElement>("[data-philosophy-card]");
          const siteHeader = document.querySelector<HTMLElement>(".topbar");

          if (!intro || !philosophy || !paper || !paperEdge || !perspectiveGrid) return;

          gsap.set(philosophy, { autoAlpha: 0 });
          const paperScale = reducedMotion ? 0.998 : 0.99;
          gsap.set(paper, { clipPath: "inset(0 100% 0 0)", scaleX: paperScale, transformOrigin: "left center" });
          gsap.set(paperEdge, { autoAlpha: 1, x: 0 });
          gsap.set(cards, { autoAlpha: 0, y: reducedMotion ? 0 : 18 });
          gsap.set(perspectiveGrid, { autoAlpha: 0 });

          perspectiveLines.forEach((line) => {
            const length = line.getTotalLength();
            line.style.strokeDasharray = `${length} ${length}`;
            line.style.strokeDashoffset = `${length}`;
          });

          const master = gsap.timeline({
            defaults: { ease: "none" },
            scrollTrigger: {
              trigger: section,
              start: "top top",
              end: () => `+=${window.innerHeight * (reducedMotion ? 2.6 : window.matchMedia("(max-width: 700px)").matches ? 5.5 : 5)}`,
              pin: section,
              pinSpacing: true,
              scrub: reducedMotion ? 0.15 : 1,
              anticipatePin: 1,
              invalidateOnRefresh: true,
              onUpdate: (self) => {
                siteHeader?.classList.toggle("is-over-light", self.progress < 0.34);
              },
            },
          });

          master.addLabel("intro", 0);
          master.addLabel("introComplete", 20);
          master.addLabel("paperStart", 20);
          master.addLabel("paperComplete", 48);
          master.addLabel("cardsStart", 52);
          master.addLabel("card01", 52);
          master.addLabel("card02", 61);
          master.addLabel("card03", 70);
          master.addLabel("card04", 79);
          master.addLabel("cardsComplete", 90);
          master.addLabel("finalHold", 100);

          master.to(philosophy, { autoAlpha: 1, duration: 0.6 }, "paperStart");
          master.fromTo(
            paper,
            { clipPath: "inset(0 100% 0 0)", scaleX: paperScale },
            { clipPath: "inset(0 0% 0 0)", scaleX: 1, duration: 28, ease: "none" },
            "paperStart",
          );
          master.fromTo(
            paperEdge,
            { x: 0, autoAlpha: 1 },
            { x: () => window.innerWidth, autoAlpha: 0.25, duration: 28, ease: "none" },
            "paperStart",
          );

          const perspectiveTimeline = gsap.timeline();
          perspectiveTimeline.fromTo(
            perspectiveGrid,
            { autoAlpha: 0 },
            { autoAlpha: 0.64, duration: reducedMotion ? 4 : 7, ease: "none" },
            0,
          );
          perspectiveTimeline.to(
            perspectiveLines,
            {
              strokeDashoffset: 0,
              duration: reducedMotion ? 1.8 : 2.5,
              stagger: { each: reducedMotion ? 0.18 : 0.36, from: "start" },
              ease: "none",
            },
            0.5,
          );
          master.add(perspectiveTimeline, "paperStart+=3");

          const cardsTimeline = createPhilosophyTimeline(philosophy, { reducedMotion });
          master.add(cardsTimeline, "cardsStart");
          master.to({}, { duration: 10 }, "cardsComplete");

          section.dataset.motionEnhanced = "true";
          ScrollTrigger.refresh();
          void document.fonts.ready.then(() => ScrollTrigger.refresh());
        }, section);

        return () => {
          delete section.dataset.motionEnhanced;
          context.revert();
        };
      });
    });
  }

  function unmountNarrative() {
    mountedSections.forEach((media) => media.revert());
    mountedSections.clear();
  }

  mountNarrative();
  document.addEventListener("astro:page-load", mountNarrative);
  document.addEventListener("astro:before-swap", unmountNarrative);
  import.meta.hot?.dispose(unmountNarrative);
</script>
