    <p class="manifesto-expertise" data-scroll-reveal>Equipos especialistas en estructuras.</p>
  </div>
</section>

<style>
  .manifesto-section {
    display: grid;
    min-height: min(86svh, 820px);
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    background: var(--bg-subtle);
  }

  .manifesto-visual {
    position: relative;
    min-width: 0;
    min-height: min(86svh, 820px);
    margin: 0;
    overflow: hidden;
    background: var(--panel);
  }

  .manifesto-visual::after {
    position: absolute;
    inset: 52% 0 0;
    background: linear-gradient(180deg, transparent, rgba(26, 43, 81, 0.82));
    content: "";
    pointer-events: none;
  }

  .manifesto-visual img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .manifesto-visual-caption {
    position: absolute;
    z-index: 1;
    right: clamp(28px, 4.5vw, 72px);
    bottom: clamp(28px, 4.2vw, 64px);
    left: clamp(28px, 4.5vw, 72px);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    color: var(--bg);
  }

  .manifesto-visual-caption strong {
    font: 700 clamp(21px, 2vw, 30px) / 1.2 var(--font-heading);
  }

  .manifesto-visual-caption span {
    color: var(--accent);
    font: 400 clamp(14px, 1.2vw, 17px) / 1.35 var(--font-body);
    text-align: right;
  }

  .manifesto-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(116px, 14svh, 136px) clamp(32px, 4.2vw, 76px) 36px;
  }

  .manifesto-copy {
    max-width: 760px;
  }

  .manifesto-copy h2 {
    margin: 0 0 16px;
    color: var(--brand-navy);
    font: 700 clamp(30px, 2.9vw, 46px) / 1.08 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .manifesto-copy > p {
    max-width: 34ch;
    margin: 0;
    color: var(--ink-secondary);
    font: 400 clamp(17px, 1.5vw, 21px) / 1.38 var(--font-body);
  }

  .manifesto-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2.5vw, 34px);
    margin-top: clamp(22px, 3svh, 36px);
  }

  .manifesto-stat {
    min-width: 0;
    padding-top: 14px;
    border-top: 1px solid var(--line-strong);
  }

  .manifesto-stat__value {
