<section class="manifesto-section" id="nosotros" data-header-theme="light" aria-labelledby="manifesto-title">
  <figure class="manifesto-visual">
    <img
      src="/assets/hero/vivienda-campestre/SaveClip.App_656741461_18110535115704309_3954471314843807473_n.jpg"
      alt="Vivienda diseñada y construida por INGENIUM"
      width="1440"
      height="1920"
      loading="lazy"
      decoding="async"
    />
  </figure>

  <div class="manifesto-content">
    <div class="manifesto-copy">
      <h2 id="manifesto-title">No diseñamos en el vacío.</h2>
      <p>
        Leemos el contexto, hacemos las preguntas correctas y conectamos cada decisión con la realidad del proyecto.
      </p>
    </div>

    <div class="manifesto-stats" aria-label="Datos del equipo INGENIUM">
      <article class="manifesto-stat">
        <span class="manifesto-stat__value" data-counter data-count="8" data-suffix="+">08+</span>
        <p>Años de experiencia en el sector</p>
      </article>
      <article class="manifesto-stat">
        <span class="manifesto-stat__value" data-counter data-count="4" data-suffix="">04</span>
        <p>Principios que guían cada proyecto</p>
      </article>
    </div>

    <p class="manifesto-expertise" id="equipo">Equipos especialistas en estructuras.</p>
  </div>
</section>

<style>
  .manifesto-section {
    display: grid;
    min-height: 100svh;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    background: var(--bg-subtle);
  }

  .manifesto-visual {
    position: relative;
    min-width: 0;
    min-height: 100svh;
    margin: 0;
    overflow: hidden;
    background: var(--panel);
  }

  .manifesto-visual img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }

  .manifesto-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 6.2vw, 104px);
  }

  .manifesto-copy {
    max-width: 760px;
  }

  .manifesto-copy h2 {
    margin: 0 0 16px;
    color: var(--brand-navy);
    font: 700 clamp(36px, 4vw, 60px) / 1.08 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .manifesto-copy > p {
    max-width: 34ch;
    margin: 0;
    color: var(--ink-secondary);
    font: 400 clamp(20px, 2.1vw, 29px) / 1.4 var(--font-body);
  }

  .manifesto-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 42px);
    margin-top: clamp(42px, 7svh, 72px);
  }

  .manifesto-stat {
    min-width: 0;
    padding-top: 20px;
    border-top: 1px solid var(--line-strong);
  }

  .manifesto-stat__value {
    display: block;
    color: var(--brand-navy);
    font: 700 clamp(58px, 6.4vw, 92px) / 1 var(--font-heading);
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  .manifesto-stat p {
    max-width: 22ch;
    margin: 12px 0 0;
    color: var(--ink-secondary);
    font: 400 clamp(16px, 1.3vw, 19px) / 1.4 var(--font-body);
  }

  .manifesto-expertise {
    width: fit-content;
    margin: clamp(32px, 5svh, 52px) 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--accent);
    color: var(--brand-navy);
    font: 700 clamp(17px, 1.5vw, 21px) / 1.35 var(--font-heading);
  }

  @media (max-width: 900px) {
    .manifesto-section {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .manifesto-content {
      padding: clamp(32px, 5vw, 56px);
    }

    .manifesto-copy h2 {
      font-size: clamp(34px, 4.8vw, 48px);
    }

    .manifesto-copy > p {
      font-size: clamp(18px, 2.5vw, 23px);
    }
  }

  @media (max-width: 700px) {
    .manifesto-section {
      grid-template-columns: 1fr;
    }

    .manifesto-visual {
      min-height: 0;
      height: clamp(320px, 48svh, 480px);
    }

    .manifesto-visual img {
      object-position: center 22%;
    }

    .manifesto-content {
      padding: 52px 7vw 64px;
    }

    .manifesto-copy h2 {
      font-size: clamp(36px, 9vw, 48px);
    }

    .manifesto-copy > p {
      max-width: 34ch;
      font-size: clamp(19px, 5vw, 23px);
    }

    .manifesto-stats {
      gap: 18px;
      margin-top: 38px;
    }

    .manifesto-stat {
      padding-top: 15px;
    }

    .manifesto-stat__value {
      font-size: clamp(52px, 13vw, 68px);
    }

    .manifesto-stat p {
      font-size: 15px;
    }

    .manifesto-expertise {
      margin-top: 30px;
      font-size: 17px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const sections = document.querySelectorAll<HTMLElement>(".manifesto-section");

  sections.forEach((section) => {
    const counters = Array.from(section.querySelectorAll<HTMLElement>("[data-counter]"));
    if (counters.length === 0 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let animations: gsap.core.Tween[] = [];
    const context = gsap.context(() => {
      animations = counters.map((counter) => {
        const target = Number(counter.dataset.count ?? 0);
        const suffix = counter.dataset.suffix ?? "";
        const digits = Math.max(2, String(target).length);
        const value = { current: 0 };

        counter.textContent = `${String(0).padStart(digits, "0")}${suffix}`;
        return gsap.to(value, {
          current: target,
          duration: 1.35,
          ease: "power2.out",
          paused: true,
          onUpdate: () => {
            counter.textContent = `${String(Math.round(value.current)).padStart(digits, "0")}${suffix}`;
          },
        });
      });
    }, section);

    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      animations.forEach((animation) => animation.play());
      observer.disconnect();
    }, { threshold: 0.35 });

    observer.observe(section);
    document.addEventListener("astro:before-swap", () => {
      observer.disconnect();
      context.revert();
    }, { once: true });
    import.meta.hot?.dispose(() => {
      observer.disconnect();
      context.revert();
    });
  });
</script>
