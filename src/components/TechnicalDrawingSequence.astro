---
interface Props {
  sources: string[];
  duration?: number;
  fadeDuration?: number;
  holdDuration?: number;
  label?: string;
}

const {
  sources,
  duration = 3,
  fadeDuration = 0.65,
  holdDuration = 0,
  label = "Secuencia de dibujos técnicos",
} = Astro.props;
---

<div
  class="technical-drawing-sequence"
  data-sources={JSON.stringify(sources)}
  data-duration={duration}
  data-fade-duration={fadeDuration}
  data-hold-duration={holdDuration}
  role="img"
  aria-label={label}
>
  <div class="drawing-stage" aria-hidden="true"></div>
</div>

<style>
  .technical-drawing-sequence {
    width: 100%;
    height: clamp(340px, 38vw, 500px);
    overflow: hidden;
  }

  .drawing-stage {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    background: transparent;
  }

  .drawing-stage :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .technical-drawing-sequence {
      height: min(112vw, 430px);
      min-height: 300px;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  type Stroke = {
    element: SVGGeometryElement;
    length: number;
    bottom: number;
  };

  async function loadSvg(source: string): Promise<SVGSVGElement> {
    const response = await fetch(source);
    if (!response.ok) throw new Error(`No se pudo cargar ${source}`);
    const markup = await response.text();
    const parsed = new DOMParser().parseFromString(markup, "image/svg+xml");
    if (parsed.querySelector("parsererror") || parsed.documentElement.localName !== "svg") {
      throw new Error(`SVG inválido: ${source}`);
    }
    return window.document.importNode(parsed.documentElement, true) as unknown as SVGSVGElement;
  }

  async function animateSequence(host: HTMLDivElement) {
    if (host.dataset.running === "true") return;
    host.dataset.running = "true";

    const stage = host.querySelector<HTMLDivElement>(".drawing-stage");
    const sources = JSON.parse(host.dataset.sources ?? "[]") as string[];
    const duration = Number(host.dataset.duration) || 3;
    const fadeDuration = Number(host.dataset.fadeDuration) || 0.65;
    const holdDuration = Number(host.dataset.holdDuration) || 0;
    const hero = host.closest<HTMLElement>(".technical-hero");
    const background = hero?.querySelector<HTMLElement>(".hero-background");
    const backgroundSources = JSON.parse(background?.dataset.images ?? "[]") as string[];
    const backgroundLayers = Array.from(
      background?.querySelectorAll<HTMLImageElement>("[data-hero-background-layer]") ?? [],
    );
    const backgroundCache = new Map<string, Promise<void>>();
    let activeBackgroundLayer = backgroundLayers.findIndex((layer) => layer.classList.contains("is-visible"));
    let activeBackgroundSource = backgroundLayers[activeBackgroundLayer]?.getAttribute("src") ?? "";

    if (!stage || sources.length === 0) return;

    function preloadBackground(source: string): Promise<void> {
      const cached = backgroundCache.get(source);
      if (cached) return cached;

      const image = new Image();
      const promise = new Promise<void>((resolve, reject) => {
        image.addEventListener("load", () => {
          if (typeof image.decode === "function") {
            void image.decode().then(resolve).catch(resolve);
          } else {
            resolve();
          }
        }, { once: true });
        image.addEventListener("error", () => reject(new Error(`No se pudo cargar ${source}`)), { once: true });
        image.src = source;
        if (image.complete) {
          if (image.naturalWidth > 0) resolve();
          else reject(new Error(`No se pudo cargar ${source}`));
        }
      });

      backgroundCache.set(source, promise);
      return promise;
    }

    while (host.isConnected) {
      for (const [index, source] of sources.entries()) {
        if (!host.isConnected) return;

        try {
          const backgroundSource = backgroundSources[index % backgroundSources.length];
          const nextBackgroundSource = backgroundSources[(index + 1) % backgroundSources.length];
          if (nextBackgroundSource) void preloadBackground(nextBackgroundSource).catch(() => undefined);

          const [svg, backgroundLoaded] = await Promise.all([
            loadSvg(source),
            backgroundSource
              ? preloadBackground(backgroundSource).then(() => true, () => false)
              : Promise.resolve(false),
          ]);

          if (backgroundSource && backgroundLoaded && backgroundSource !== activeBackgroundSource && backgroundLayers.length > 1) {
            const nextLayerIndex = activeBackgroundLayer === 0 ? 1 : 0;
            const nextLayer = backgroundLayers[nextLayerIndex];
            nextLayer.src = backgroundSource;
            nextLayer.classList.add("is-visible");
            backgroundLayers[activeBackgroundLayer]?.classList.remove("is-visible");
            activeBackgroundLayer = nextLayerIndex;
            activeBackgroundSource = backgroundSource;
          }

          stage.replaceChildren(svg);
          const strokes = Array.from(svg.querySelectorAll<SVGGeometryElement>(".draw-stroke"));
          const measured: Stroke[] = strokes.flatMap((element) => {
            try {
              const length = element.getTotalLength();
              const box = element.getBBox();
              return length > 0 ? [{ element, length, bottom: box.y + box.height }] : [];
            } catch {
              return [];
            }
          }).sort((a, b) => b.bottom - a.bottom);

          for (const { element, length } of measured) {
            element.style.strokeDasharray = `${length} ${length}`;
            element.style.strokeDashoffset = `${length}`;
          }

          gsap.set(svg, { opacity: 1 });

          const lineDuration = Math.min(0.16, duration / 8);
          const stagger = measured.length > 1
            ? Math.max(0, (duration - lineDuration) / (measured.length - 1))
            : 0;

          await new Promise<void>((resolve) => {
            if (measured.length === 0) {
              resolve();
              return;
            }
            gsap.to(measured.map(({ element }) => element), {
              strokeDashoffset: 0,
              duration: lineDuration,
              ease: "none",
              stagger,
              onComplete: resolve,
            });
          });

          if (holdDuration > 0) {
            await new Promise<void>((resolve) => window.setTimeout(resolve, holdDuration * 1000));
          }

          await new Promise<void>((resolve) => {
            gsap.to(svg, {
              opacity: 0,
              duration: fadeDuration,
              ease: "power1.inOut",
              onComplete: resolve,
            });
          });
        } catch (error) {
          host.dataset.error = error instanceof Error ? error.message : "Error al mostrar el SVG";
        }
      }
    }
  }

  document.querySelectorAll<HTMLDivElement>(".technical-drawing-sequence").forEach((host) => {
    void animateSequence(host);
  });
</script>
