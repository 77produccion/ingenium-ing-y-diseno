---
interface Props {
  sources: string[];
  duration?: number;
  fadeDuration?: number;
  holdDuration?: number;
  fadeBlur?: number;
  label?: string;
}

const {
  sources,
  duration = 3,
  fadeDuration = 0.65,
  holdDuration = 0,
  fadeBlur = 0,
  label = "Secuencia de dibujos técnicos",
} = Astro.props;
---

<div
  class="technical-drawing-sequence"
  data-sources={JSON.stringify(sources)}
  data-duration={duration}
  data-fade-duration={fadeDuration}
  data-hold-duration={holdDuration}
  data-fade-blur={fadeBlur}
  role="img"
  aria-label={label}
>
  <div class="drawing-stage" aria-hidden="true"></div>
</div>

<style>
  .technical-drawing-sequence {
    width: 100%;
    height: var(--drawing-height, clamp(340px, 38vw, 500px));
    overflow: hidden;
  }

  .drawing-stage {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    background: transparent;
  }

  .drawing-stage :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .technical-drawing-sequence {
      height: var(--drawing-height, min(112vw, 430px));
      min-height: var(--drawing-height, 300px);
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  type Stroke = {
    element: SVGGeometryElement;
    length: number;
    bottom: number;
  };

  const svgCache = new Map<string, Promise<SVGSVGElement>>();
  const geometryCache = new Map<string, { index: number; length: number; bottom: number }[]>();
  type SequenceState = {
    visible: boolean;
    disposed: boolean;
    tween?: gsap.core.Tween;
    waiters: Set<() => void>;
  };
  const states = new Map<HTMLDivElement, SequenceState>();
  const canAnimate = (state: SequenceState) => state.visible && !document.hidden && !state.disposed;
  const waitUntilVisible = (state: SequenceState) => canAnimate(state) || state.disposed
    ? Promise.resolve()
    : new Promise<void>(resolve => state.waiters.add(resolve));
  const syncState = (state: SequenceState) => {
    state.tween?.paused(!canAnimate(state));
    if (canAnimate(state) || state.disposed) {
      state.waiters.forEach(resolve => resolve());
      state.waiters.clear();
    }
  };

  async function loadSvg(source: string): Promise<SVGSVGElement> {
    let cached = svgCache.get(source);
    if (!cached) {
      cached = fetchSvg(source);
      svgCache.set(source, cached);
      void cached.catch(() => svgCache.delete(source));
    }
    return (await cached).cloneNode(true) as SVGSVGElement;
  }

  async function fetchSvg(source: string): Promise<SVGSVGElement> {
    const response = await fetch(source);
    if (!response.ok) throw new Error(`No se pudo cargar ${source}`);
    const markup = await response.text();
    const parsed = new DOMParser().parseFromString(markup, "image/svg+xml");
    if (parsed.querySelector("parsererror") || parsed.documentElement.localName !== "svg") {
      throw new Error(`SVG inválido: ${source}`);
    }
    return window.document.importNode(parsed.documentElement, true) as unknown as SVGSVGElement;
  }

  async function animateSequence(host: HTMLDivElement, state: SequenceState) {
    if (host.dataset.running === "true") return;
    host.dataset.running = "true";

    const stage = host.querySelector<HTMLDivElement>(".drawing-stage");
    const sources = JSON.parse(host.dataset.sources ?? "[]") as string[];
    const duration = Number(host.dataset.duration) || 3;
    const fadeDuration = Number(host.dataset.fadeDuration) || 0.65;
    const holdDuration = Number(host.dataset.holdDuration) || 0;
    const fadeBlur = Number(host.dataset.fadeBlur) || 0;
    const hero = host.closest<HTMLElement>(".technical-hero");
    const background = hero?.querySelector<HTMLElement>(".hero-background");
    const backgroundSources = JSON.parse(background?.dataset.images ?? "[]") as string[];
    const backgroundLayers = Array.from(
      background?.querySelectorAll<HTMLImageElement>("[data-hero-background-layer]") ?? [],
    );
    const backgroundCache = new Map<string, Promise<void>>();
    let activeBackgroundLayer = backgroundLayers.findIndex((layer) => layer.classList.contains("is-visible"));
    let activeBackgroundSource = backgroundLayers[activeBackgroundLayer]?.getAttribute("src") ?? "";

    if (!stage || sources.length === 0) return;

    function preloadBackground(source: string): Promise<void> {
      const cached = backgroundCache.get(source);
      if (cached) return cached;

      const image = new Image();
      const promise = new Promise<void>((resolve, reject) => {
        image.addEventListener("load", () => {
          if (typeof image.decode === "function") {
            void image.decode().then(resolve).catch(resolve);
          } else {
            resolve();
          }
        }, { once: true });
        image.addEventListener("error", () => reject(new Error(`No se pudo cargar ${source}`)), { once: true });
        image.src = source;
        if (image.complete) {
          if (image.naturalWidth > 0) resolve();
          else reject(new Error(`No se pudo cargar ${source}`));
        }
      });

      backgroundCache.set(source, promise);
      return promise;
    }

    while (host.isConnected && !state.disposed) {
      for (const [index, source] of sources.entries()) {
        await waitUntilVisible(state);
        if (!host.isConnected || state.disposed) return;

        try {
          const backgroundSource = backgroundSources[index % backgroundSources.length];
          const nextBackgroundSource = backgroundSources[(index + 1) % backgroundSources.length];
          if (nextBackgroundSource) void preloadBackground(nextBackgroundSource).catch(() => undefined);

          const [svg, backgroundLoaded] = await Promise.all([
            loadSvg(source),
            backgroundSource
              ? preloadBackground(backgroundSource).then(() => true, () => false)
              : Promise.resolve(false),
          ]);
          await waitUntilVisible(state);
          if (!host.isConnected || state.disposed) return;

          if (backgroundSource && backgroundLoaded && backgroundSource !== activeBackgroundSource && backgroundLayers.length > 1) {
            const nextLayerIndex = activeBackgroundLayer === 0 ? 1 : 0;
            const nextLayer = backgroundLayers[nextLayerIndex];
            nextLayer.src = backgroundSource;
            nextLayer.classList.add("is-visible");
            backgroundLayers[activeBackgroundLayer]?.classList.remove("is-visible");
            activeBackgroundLayer = nextLayerIndex;
            activeBackgroundSource = backgroundSource;
          }

          // Geometry must be attached for getBBox(), but don't flash all lines
          // while its preparation is spread across short, responsive batches.
          svg.style.opacity = '0';
          stage.replaceChildren(svg);
          const strokes = Array.from(svg.querySelectorAll<SVGGeometryElement>(".draw-stroke"));
          let geometry = geometryCache.get(source);
          if (!geometry) {
            geometry = [];
            let sliceStart = performance.now();
            for (const [index, element] of strokes.entries()) {
              try {
                const length = element.getTotalLength();
                const box = element.getBBox();
                if (length > 0) geometry.push({ index, length, bottom: box.y + box.height });
              } catch { /* Ignore non-measurable geometry. */ }
              if (performance.now() - sliceStart > 6) {
                await new Promise<void>(resolve => requestAnimationFrame(() => resolve()));
                await waitUntilVisible(state);
                if (state.disposed) return;
                sliceStart = performance.now();
              }
            }
            geometry.sort((a, b) => b.bottom - a.bottom);
            geometryCache.set(source, geometry);
          }
          const measured: Stroke[] = geometry.map(({ index, length, bottom }) => ({ element: strokes[index], length, bottom }));

          let sliceStart = performance.now();
          for (const { element, length } of measured) {
            element.style.strokeDasharray = `${length} ${length}`;
            element.style.strokeDashoffset = `${length}`;
            if (performance.now() - sliceStart > 6) {
              await new Promise<void>(resolve => requestAnimationFrame(() => resolve()));
              await waitUntilVisible(state);
              if (state.disposed) return;
              sliceStart = performance.now();
            }
          }

          gsap.set(svg, { opacity: 1, filter: 'blur(0px)' });

          const lineDuration = Math.min(0.16, duration / 8);
          const stagger = measured.length > 1
            ? Math.max(0, (duration - lineDuration) / (measured.length - 1))
            : 0;

          await new Promise<void>((resolve) => {
            if (measured.length === 0) {
              resolve();
              return;
            }
            state.tween = gsap.to(measured.map(({ element }) => element), {
              strokeDashoffset: 0,
              duration: lineDuration,
              ease: "none",
              stagger,
              paused: !canAnimate(state),
              onComplete: () => { state.tween = undefined; resolve(); },
              onInterrupt: resolve,
            });
          });

          if (state.disposed) return;
          if (holdDuration > 0) {
            await new Promise<void>((resolve) => {
              state.tween = gsap.delayedCall(holdDuration, () => { state.tween = undefined; resolve(); });
              state.tween.eventCallback('onInterrupt', resolve);
              syncState(state);
            });
          }
          await waitUntilVisible(state);
          if (state.disposed) return;

          await new Promise<void>((resolve) => {
            state.tween = gsap.to(svg, {
              opacity: 0,
              filter: `blur(${fadeBlur}px)`,
              duration: fadeDuration,
              ease: "power1.inOut",
              paused: !canAnimate(state),
              onComplete: () => { state.tween = undefined; resolve(); },
              onInterrupt: resolve,
            });
          });
        } catch (error) {
          host.dataset.error = error instanceof Error ? error.message : "Error al mostrar el SVG";
        }
      }
    }
  }

  const visibilityObserver = new IntersectionObserver(changes => {
    for (const entry of changes) {
      const host = entry.target as HTMLDivElement;
      const state = states.get(host);
      if (!state) continue;
      state.visible = entry.isIntersecting && entry.intersectionRatio >= .05;
      syncState(state);
      if (canAnimate(state)) void animateSequence(host, state);
    }
  }, { threshold: [0, .05] });
  document.querySelectorAll<HTMLDivElement>('.technical-drawing-sequence').forEach(host => {
    states.set(host, { visible: false, disposed: false, waiters: new Set() });
    visibilityObserver.observe(host);
  });
  const syncVisibility = () => {
    states.forEach((state, host) => {
      syncState(state);
      if (canAnimate(state)) void animateSequence(host, state);
    });
  };
  document.addEventListener('visibilitychange', syncVisibility);
  const cleanup = () => {
    visibilityObserver.disconnect();
    document.removeEventListener('visibilitychange', syncVisibility);
    states.forEach((state, host) => {
      state.disposed = true;
      state.tween?.kill();
      syncState(state);
      delete host.dataset.running;
    });
    states.clear();
  };
  document.addEventListener('astro:before-swap', cleanup, { once: true });
  import.meta.hot?.dispose(cleanup);
</script>
