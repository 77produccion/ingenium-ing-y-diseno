---
import Icon from './Icon.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { servicePreviews } from '../lib/hero-film.mjs';
const services = [
  { title: 'Consultoría', href: '/consultoria', image: `/assets/hero-videos/${servicePreviews.consultoria.file}-poster.webp`, alt: 'Vista aérea del entorno urbano de una obra de INGENIUM', video: `/assets/hero-videos/${servicePreviews.consultoria.file}.mp4` },
  { title: 'Construcción', href: '/construccion', image: `/assets/hero-videos/${servicePreviews.construccion.file}-poster.webp`, alt: 'Construcción de una vivienda', video: `/assets/hero-videos/${servicePreviews.construccion.file}.mp4` },
];
---
<section class="services-showcase section-shell" id="servicios" aria-labelledby="services-title">
  <h2 id="services-title">Nuestros servicios.</h2>
  <div class="services-grid">
    {services.map(service => <a class="service-panel" href={service.href} data-service-panel data-preview={service.video} aria-label={`Conoce nuestros servicios de ${service.title.toLowerCase()}`}>
      <ResponsiveImage src={service.image} alt={service.alt} widths={[480,800,1280]} aspectRatio={1.6} sizes="(max-width: 767px) 90vw, 46vw" />
      <video muted playsinline loop preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
      <div class="service-shade" aria-hidden="true"></div>
      <h3>{service.title}</h3>
      <span class="service-arrow"><Icon name="arrowRight" /></span>
    </a>)}
  </div>
</section>
<style>
  .services-showcase { width: 100%; padding: 56px 4vw; background: var(--brand-navy); }
  h2 { max-width: 1472px; margin: 0 auto 28px; color: var(--bg); font-size: clamp(36px,4vw,60px); line-height: 1; letter-spacing: -.055em; }
  .services-grid { max-width: 1472px; margin-inline: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .service-panel { position: relative; isolation: isolate; display: flex; align-items: flex-end; height: clamp(300px,29vw,420px); padding: 32px; overflow: hidden; background: #172031; color: #fff; }
  .service-panel :global(img), video, .service-shade { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .service-panel :global(img), video { object-fit: cover; object-position: center; transition: opacity .6s ease, transform 1.1s ease; }
  video { opacity: 0; }
  .is-playing video { opacity: 1; }
  .service-shade { background: linear-gradient(180deg, transparent 35%, #080c165c 65%, #080c16d9); }
  h3 { margin: 0; padding-right: 44px; color: #fff; font-size: clamp(32px,4.2vw,64px); letter-spacing: -.055em; line-height: 1.05; }
  .service-arrow { position: absolute; right: 28px; bottom: 32px; display: grid; place-items: center; width: 40px; height: 40px; transition: transform .35s ease; }
  .service-panel:hover .service-arrow { transform: translateX(5px); }
  .service-panel:hover :global(img) { transform: scale(1.025); }
  .service-panel:focus-visible { outline-color: var(--accent); }
  @media(max-width:767px) { .services-showcase { padding: 36px 20px; } .services-grid { grid-template-columns: 1fr; } .service-panel { height: 280px; padding: 24px; } h3 { font-size: clamp(34px,8vw,52px); } .service-arrow { right: 20px; bottom: 22px; } }
</style>
<script>
  import { registerViewportMedia } from '../lib/viewport-media';
  document.querySelectorAll<HTMLElement>('[data-service-panel]').forEach(panel => {
    const video = panel.querySelector('video')!;
    let active = false;
    let disposed = false;
    let run = 0;
    const play = () => {
      const token = ++run;
      if (!active || disposed || document.hidden) return;
      if (!video.getAttribute('src')) video.src = panel.dataset.preview!;
      video.play().then(() => {
        if (active && !document.hidden && !disposed && token === run) panel.classList.add('is-playing');
        else if (!active || document.hidden || disposed) video.pause();
      }).catch(() => panel.classList.remove('is-playing'));
    };
    video.addEventListener('error', () => panel.classList.remove('is-playing'));
    const playback = registerViewportMedia({
      element: panel, video, minRatio: .4, priority: 1,
      onActiveChange(playing) {
        active = playing;
        if (active) play();
        else { ++run; video.pause(); } // Keep the last sharp frame, no image flash.
      },
    });
    const prefer = () => playback.setPriority(3);
    const restore = () => playback.setPriority(panel.matches(':hover, :focus-within') ? 3 : 1);
    panel.addEventListener('pointerenter', prefer);
    panel.addEventListener('pointerleave', restore);
    panel.addEventListener('focusin', prefer);
    panel.addEventListener('focusout', () => queueMicrotask(restore));
    const cleanup = () => { disposed = true; playback.dispose(); video.removeAttribute('src'); video.load(); };
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    import.meta.hot?.dispose(cleanup);
  });
</script>
