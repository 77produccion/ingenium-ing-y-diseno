---
import arrowRight from '@tabler/icons/outline/arrow-right.svg?raw';
import chevronDown from '@tabler/icons/outline/chevron-down.svg?raw';
import x from '@tabler/icons/outline/x.svg?raw';
import mail from '@tabler/icons/outline/mail.svg?raw';
import whatsapp from '@tabler/icons/outline/brand-whatsapp.svg?raw';
import arrowUpRight from '@tabler/icons/outline/arrow-up-right.svg?raw';
import arrowUp from '@tabler/icons/outline/arrow-up.svg?raw';
import chevronLeft from '@tabler/icons/outline/chevron-left.svg?raw';
import chevronRight from '@tabler/icons/outline/chevron-right.svg?raw';
const icons = { arrowRight, arrowUpRight, arrowUp, chevronDown, chevronLeft, chevronRight, x, mail, whatsapp };
interface Props { name: keyof typeof icons }
const { name } = Astro.props;
---
<span class="icon" aria-hidden="true" set:html={icons[name]} />
<style>
  .icon { display: inline-flex; width: 24px; height: 24px; flex-shrink: 0; }
  .icon :global(svg) { width: 100%; height: 100%; stroke-width: 1.5; }
</style>
