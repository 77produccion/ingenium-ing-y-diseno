---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import NarrativeSection from '../components/NarrativeSection.astro';
import Manifesto from '../components/Manifesto.astro';
import Capabilities from '../components/Capabilities.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="INGENIUM — Ingeniería visible">
  <Header />
  <main id="inicio">
    <Hero />
    <NarrativeSection />
    <Manifesto />
    <Capabilities />
    <Process />
    <Contact />
  </main>
  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';

  // Accordion logic for Capabilities
  const accordionButtons = document.querySelectorAll<HTMLButtonElement>('.cap-item button');
  accordionButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.cap-item');
      if (!item) return;

      const content = item.querySelector<HTMLElement>('.cap-content');
      const symbol = button.querySelector<HTMLElement>('.cap-symbol');
      const isOpen = button.getAttribute('aria-expanded') === 'true';

      button.setAttribute('aria-expanded', String(!isOpen));
      if (symbol) {
        symbol.textContent = isOpen ? '+' : '−';
      }
      if (content) {
        content.hidden = isOpen;
      }
    });
  });

  // Smoothly scroll hero calls to action to their sections, regardless of reduced-motion preference.
  document.querySelectorAll<HTMLAnchorElement>('[data-smooth-scroll]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const href = link.getAttribute('href');
      const target = href ? document.querySelector<HTMLElement>(href) : null;
      if (!target) return;

      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Mobile navigation drawer toggle
  const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.topbar nav');

  menuButton?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('open');
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('open');
      menuButton?.setAttribute('aria-expanded', 'false');
      menuButton?.setAttribute('aria-label', 'Abrir menú');
    });
  });

  // Use a dark header palette over light sections, and a light palette over dark sections.
  const siteHeader = document.querySelector<HTMLElement>('.topbar');
  const headerCapsule = document.querySelector<HTMLElement>('.topbar-inner');
  const siteNavigation = document.querySelector<HTMLElement>('#site-navigation');
  const categoryLinks = Array.from(
    siteNavigation?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not(.nav-cta)') ?? [],
  );
  const categoryTargets = categoryLinks.flatMap((link) => {
    const selector = link.getAttribute('href');
    const target = selector ? document.querySelector<HTMLElement>(selector) : null;
    return target ? [{ link, target }] : [];
  });
  const themedSections = Array.from(document.querySelectorAll<HTMLElement>('[data-header-theme]'));
  let headerThemeObserver: IntersectionObserver | undefined;

  const observeHeaderTheme = () => {
    headerThemeObserver?.disconnect();
    if (!siteHeader || !headerCapsule || themedSections.length === 0) return;

    const markerTop = Math.max(0, Math.round(headerCapsule.getBoundingClientRect().bottom) - 1);
    const markerHeight = 2;
    const bottomInset = Math.max(0, window.innerHeight - markerTop - markerHeight);

    headerThemeObserver = new IntersectionObserver(() => {
      const sectionUnderHeader = themedSections
        .filter((section) => {
          const bounds = section.getBoundingClientRect();
          return bounds.top <= markerTop + markerHeight && bounds.bottom >= markerTop;
        })
        .sort((first, second) => second.getBoundingClientRect().top - first.getBoundingClientRect().top)[0];

      if (sectionUnderHeader) {
        siteHeader.classList.toggle('is-over-light', sectionUnderHeader.dataset.headerTheme === 'light');
      }

      const activeCategory = categoryTargets
        .filter(({ target }) => {
          const bounds = target.getBoundingClientRect();
          return bounds.top <= markerTop + markerHeight && bounds.bottom >= markerTop;
        })
        .sort((first, second) => second.target.getBoundingClientRect().top - first.target.getBoundingClientRect().top)[0]?.link;

      categoryLinks.forEach((link) => {
        if (link === activeCategory) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    }, {
      rootMargin: `-${markerTop}px 0px -${bottomInset}px 0px`,
      threshold: 0,
    });

    themedSections.forEach((section) => headerThemeObserver?.observe(section));
  };

  observeHeaderTheme();
  window.addEventListener('resize', observeHeaderTheme, { passive: true });

  let revealObserver: IntersectionObserver | undefined;
  let revealContexts: gsap.Context[] = [];

  function mountScrollReveals() {
    revealObserver?.disconnect();
    revealContexts.forEach((context) => context.revert());
    revealContexts = [];

    const revealTargets = Array.from(
      document.querySelectorAll<HTMLElement>('[data-scroll-reveal], [data-reveal-children]'),
    );
    if (!('IntersectionObserver' in window) || revealTargets.length === 0) return;

    revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const element = entry.target as HTMLElement;
        const grouped = element.hasAttribute('data-reveal-children');
        const targets = grouped
          ? Array.from(element.children).filter((child): child is HTMLElement => child instanceof HTMLElement)
          : [element];
        revealObserver?.unobserve(element);
        if (targets.length === 0) return;

        const delay = Number(element.dataset.revealDelay) || 0;
        const context = gsap.context(() => {
          gsap.fromTo(targets,
            { autoAlpha: 0, y: 22 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.82,
              delay,
              stagger: grouped ? 0.12 : 0,
              ease: 'power2.out',
              clearProps: 'transform,opacity,visibility',
            },
          );
        }, element);
        revealContexts.push(context);
      });
    }, { threshold: 0.16, rootMargin: '0px 0px -7% 0px' });

    revealTargets.forEach((target) => revealObserver?.observe(target));
  }

  function unmountScrollReveals() {
    revealObserver?.disconnect();
    revealContexts.forEach((context) => context.revert());
    revealContexts = [];
  }

  mountScrollReveals();
  document.addEventListener('astro:page-load', mountScrollReveals);
  document.addEventListener('astro:before-swap', unmountScrollReveals);
  import.meta.hot?.dispose(unmountScrollReveals);
</script>
